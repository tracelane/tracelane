{
	"name": "@tracelanedev/mcp",
	"version": "0.2.4",
	"description": "Tracelane MCP server — read-only, tenant-scoped trace access",
	"mcpName": "io.github.tracelane/tracelane-mcp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tracelane/tracelane.git",
		"directory": "apps/mcp"
	},
	"homepage": "https://tracelane.dev",
	"bugs": "https://github.com/tracelane/tracelane/issues",
	"bin": {
		"tracelane-mcp": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"gen:evals": "node scripts/gen-eval-manifest.mjs --write",
		"prebuild": "node scripts/gen-eval-manifest.mjs --check && node scripts/check-registry-manifest.mjs --check",
		"build": "tsup src/index.ts --format cjs --dts --no-splitting && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
		"prepublishOnly": "pnpm run build",
		"start": "node dist/index.js",
		"lint": "biome check src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.4.0",
		"@clickhouse/client": "^1.8.0",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/node": "^22.0.0",
		"tsx": "^4.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.5.0",
		"vitest": "^2.0.0"
	},
	"files": ["dist", "server.json"],
	"engines": { "node": "^18.19.0 || >=20.6.0" },
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"keywords": [
		"tracelane",
		"mcp",
		"model-context-protocol",
		"opentelemetry",
		"ai-observability",
		"llm-tracing"
	]
}
