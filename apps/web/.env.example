# Tracelane dashboard — environment variables
# Copy to .env.local and fill in values before running.

# ── WorkOS (auth) ─────────────────────────────────────────────────────────────
# Get these from your WorkOS dashboard: https://dashboard.workos.com
WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxx
WORKOS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# 32+ byte random secret: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ClickHouse ────────────────────────────────────────────────────────────────
# Dev: docker compose -f infra/dev/docker-compose.yml up -d
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=tracelane

# ── Tracelane gateway ─────────────────────────────────────────────────────────
# Shown in the traces page header. Point agents here.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# ── Neon Postgres (tenant/billing metadata) ───────────────────────────────────
DATABASE_URL=postgres://user:password@ep-xxx.us-east-1.aws.neon.tech/tracelane

# ── Billing — Polar.sh ────────────────────────────────────────────────────────
# Checkout and portal calls proxy through the Rust gateway, which owns
# POLAR_ACCESS_TOKEN (see top-level .env.example). The dashboard needs to know
# where the gateway lives (NEXT_PUBLIC_GATEWAY_URL above) and where to redirect
# the user after the Polar-hosted portal closes.
TRACELANE_BILLING_RETURN_URL=https://app.tracelane.dev/settings/billing
# The webhook route (app/api/webhooks/polar) verifies Standard Webhooks
# signatures with POLAR_WEBHOOK_SECRET and pins the organization with
# POLAR_EXPECTED_ORGANIZATION_ID — both `wrangler secret put` on the Worker.
POLAR_WEBHOOK_SECRET=polar_whs_xxx
POLAR_EXPECTED_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# BILL-02 O4 — SYNCHRONOUS annual pairing (optional, recommended). The ONE Polar
# token the dashboard holds, scoped to EXACTLY `customers:write` +
# `customer_sessions:write` + `subscriptions:write` (Polar OpenAPI 2026-04: the
# payment-methods read, the customer session that sets the default card through
# the portal API (B-435), the subscriptions list and the usage-subscription POST).
# Minted by the founder in the Polar dashboard (Settings → Developers → New
# token; no API exists for organization tokens), then
# `wrangler secret put POLAR_WORKER_TOKEN`. Unset → the webhook logs one line and
# the usage half waits for scripts/ops/polar-reconcile-annual.ts. The deadline for
# the whole pairing is billing_policy.annual_pairing_deadline_ms (seeded from
# db/plans.v3.json), never a literal here.
# POLAR_WORKER_TOKEN=polar_oat_xxx
# POLAR_SANDBOX=1   # route the pairing calls at sandbox-api.polar.sh (never on prod)
