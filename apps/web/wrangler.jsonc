{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tracelane-web",
	"main": ".open-next/worker.js",
	// nodejs_compat is mandatory: WorkOS AuthKit + node:crypto (api-key HMAC,
	// Polar webhook verify, CMK PEM parse) resolve through it. The 2025-09-23
	// compatibility_date also auto-populates process.env from vars/secrets, which
	// is how our `process.env.*` reads (DATABASE_URL, WORKOS_*, pepper, etc.) work
	// on the Worker. OpenNext additionally bridges env onto process.env per request.
	"compatibility_date": "2025-09-23",
	"compatibility_flags": ["nodejs_compat"],
	// Static assets emitted by the OpenNext build, served by the Worker's asset
	// handler. The ASSETS binding is what OpenNext's worker entry expects.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Smart Placement — run the Worker NEAR THE GATEWAY, not near the user.
	//
	// Measured 2026-08-05 on the /dashboard 6s report: the gateway answers
	// /health in 0.9ms on-node and 8.8ms through Caddy on-node, but 588ms mean /
	// 2,745ms max over the WAN. The backend is not slow — the wide-area hop is,
	// and it has a heavy tail.
	//
	// /dashboard issues EIGHT gateway subrequests in a Promise.all, so it waits
	// for the slowest of eight draws from that tail. That is why only the
	// dashboard is slow: /traces and /slo make 2-5 calls and mostly escape it.
	//
	// Default placement puts the Worker at the edge beside the user, making all
	// eight round trips cross the ocean. Smart Placement moves the Worker beside
	// the origin, so those eight become short hops and only the HTML response
	// crosses the WAN once. This is the documented remedy for exactly this
	// shape (multiple subrequests to one centralized backend).
	"placement": {
		"mode": "smart"
	}
	// Runtime config (incl. the PUBLIC NEXT_PUBLIC_* gateway/redirect URLs) is set
	// via `wrangler secret put` — plaintext `vars` here are NOT bridged onto
	// `process.env` by OpenNext, but secrets ARE (that is how DATABASE_URL /
	// WORKOS_* reach `process.env.*` on the Worker). The server route handlers
	// read `process.env.NEXT_PUBLIC_GATEWAY_URL` at RUNTIME (OpenNext does not
	// build-inline it); when unset it falls back to `http://localhost:8080`,
	// which Cloudflare blocks with error 1003 on a Worker subrequest — silently
	// killing checkout AND every gateway read (`lib/gateway.ts` throws in prod).
	// REQUIRED secrets: NEXT_PUBLIC_GATEWAY_URL, NEXT_PUBLIC_WORKOS_REDIRECT_URI,
	// DATABASE_URL, WORKOS_API_KEY/CLIENT_ID/REDIRECT_URI/COOKIE_*, POLAR_*,
	// TRACELANE_APIKEY_PEPPER (see `wrangler secret list`).
}
