{
	"name": "@tracelanedev/web",
	"version": "0.1.0",
	"private": true,
	"description": "Tracelane dashboard \u2014 Next.js 16 App Router",
	"scripts": {
		"dev": "next dev --turbopack",
		"prebuild": "pnpm --filter @tracelanedev/audit-verifier build",
		"build": "next build --webpack && node scripts/check-css-built.mjs",
		"start": "next start",
		"cf:build": "pnpm --filter @tracelanedev/audit-verifier build && opennextjs-cloudflare build && node scripts/check-editor-isolation.mjs",
		"cf:preview": "opennextjs-cloudflare preview",
		"cf:deploy": "opennextjs-cloudflare deploy",
		"lint": "biome check app/ components/ lib/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:seed": "node db/seed.mjs"
	},
	"dependencies": {
		"@neondatabase/serverless": "^0.10.0",
		"@tanstack/react-query": "^5.62.0",
		"@tracelanedev/audit-verifier": "workspace:*",
		"@tracelanedev/ui": "workspace:*",
		"@workos-inc/authkit-nextjs": "^4.0.1",
		"drizzle-orm": "^0.45.2",
		"next": "16.4.6",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@electric-sql/pglite": "^0.5.4",
		"@opennextjs/cloudflare": "1.20.16",
		"@playwright/test": "^1.49.1",
		"@tailwindcss/postcss": "^4.0.0",
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/react": "^16.0.0",
		"@types/node": "^22.0.0",
		"@types/react": "19.0.0",
		"@types/react-dom": "19.0.0",
		"babel-plugin-react-compiler": "1.0.0",
		"drizzle-kit": "^0.30.0",
		"jsdom": "^25.0.0",
		"knip": "^6.29.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.5.0",
		"vitest": "^3.2.6",
		"wrangler": "4.160.1"
	},
	"license": "Apache-2.0"
}
