---
import CompareTable from "../components/CompareTable.astro";
import Icon from "../components/Icon.astro";
/**
 * tracelane.dev homepage.
 *
 * REBUILT 2026-08-24 against cursor.com's layout language (founder instruction),
 * RENOVATED 2026-09-02 for a premium finish, RE-UNIFIED 2026-09-04 onto the app's
 * shared Cupertino palette + a very-low-text pass (founder ruling, overriding the
 * 2026-09-03 "site keeps its warm palette" ruling — see `global.css`'s header).
 *
 * NOTHING FACTUAL CHANGED and no number was added. Every price, date, citation and
 * link is the one already on the page; the fact strip repeats claims made further
 * down. Paragraphs were CUT to a headline + one line per section — the sell now
 * happens in the visuals: an animated, hover-reactive request-flow diagram in the
 * hero (CSS + vanilla JS, no libraries, `prefers-reduced-motion` respected), icon
 * chips for the three failure modes, and Record → Replay → Prove as a 3-step
 * "how it works". The audit ledger's ledger-chain diagram and the two terminal
 * frames are unchanged — they were already visuals, not prose. FAQ and the
 * compliance/trust cards keep their full text: those are regulatory and licensing
 * claims under the honesty locks, not marketing copy, and trimming them would cut
 * the substantiating detail the locks require.
 */
import Base from "../layouts/Base.astro";
import PricingTable from "../components/PricingTable.astro";

const providers = [
  "OpenAI",
  "Anthropic",
  "Google",
  "Mistral",
  "Llama",
  "Bedrock",
  "Groq",
  "150+ providers",
];

/**
 * Gateway-overhead benchmark — every number here is copied verbatim from
 * `apps/docs/benchmarks.mdx` (2026-09-07 run). Do not hand-edit a number;
 * change the source file and copy it across. `run2` is what the chart bars
 * and headline show; `run1` is the second line under each row. `rssMb` is
 * peak RSS of the gateway process, run 2 unless `rssNote` says otherwise.
 * `footnote` keys the † / ‡ markers reproduced below the chart.
 */
type BenchMetric = { p50: number; p95: number; p99: number };
type BenchRow = {
  name: string;
  version: string | null;
  run1: BenchMetric | null;
  run2: BenchMetric | null;
  rssMb: number | null;
  rssNote?: string;
  highlight?: boolean;
  footnote?: "bifrost" | "litellm-rust";
};

const benchRows: BenchRow[] = [
  {
    name: "Tracelane",
    version: "1f3af9ad",
    run1: { p50: 2, p95: 4, p99: 5 },
    run2: { p50: 2, p95: 4, p99: 5 },
    rssMb: 14,
    highlight: true,
  },
  {
    name: "Bifrost",
    version: "v2.0.0",
    run1: { p50: 2, p95: 2, p99: 3 },
    run2: { p50: 2, p95: 2, p99: 3 },
    rssMb: 101,
    footnote: "bifrost",
  },
  {
    name: "Portkey (OSS)",
    version: "1.15.2",
    run1: { p50: 4, p95: 7, p99: 9 },
    run2: { p50: 3, p95: 5, p99: 8 },
    rssMb: 177,
    rssNote: "run 1; run 2 not sampled",
  },
  {
    name: "LiteLLM Python",
    version: "1.100.0",
    run1: { p50: 15, p95: 36, p99: 52 },
    run2: { p50: 14, p95: 34, p99: 47 },
    rssMb: 323,
  },
  {
    name: "LiteLLM Rust",
    version: null,
    run1: null,
    run2: null,
    rssMb: null,
    footnote: "litellm-rust",
  },
];

// Bar-width scale: the largest measured value across every row is LiteLLM
// Python's run-2 p99 (47ms); round up to a clean ceiling so bars have a
// little headroom rather than the longest bar touching the edge.
const benchScaleMax = 50;
const benchPct = (ms: number) => `${((ms / benchScaleMax) * 100).toFixed(1)}%`;
---

<Base>
  {/* ===== Hero ===== */}
  <section class="panel hero" style="padding-top:clamp(3.5rem,8vw,6.5rem)">
    <div class="max-w-3xl text-left">
      <span class="badge hero-rise" style="--d:0s"><span class="dot"></span>open source · self-host · your keys, 0% markup</span>

      <h1 class="mt-7 display-xl text-fg headline-in" style="--d:0.06s">
        The <span class="grad-text">flight recorder</span><br class="hidden sm:block" /> for AI agents
      </h1>

      <p class="mt-6 lede hero-rise" style="--d:0.12s">
        Every call, traced. Every trace, provable.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3 hero-rise" style="--d:0.18s">
        <a href="https://app.tracelane.dev/sign-in" class="btn-primary">Start free <span aria-hidden="true">→</span></a>
        <a href="https://github.com/tracelane" class="btn-secondary" rel="me noopener">GitHub</a>
        <span class="text-sm text-fg-dim sm:ml-1">no credit card · apache-2.0 core</span>
      </div>

      <div class="mt-8 fact-strip hero-rise" style="--d:0.22s" aria-label="At a glance">
        <span>sha-256 hash chain</span>
        <span>ed25519-signed merkle root</span>
        <span>150+ providers</span>
        <span>one rust binary</span>
      </div>
    </div>

    {/* The stage: an animated, hover-reactive request-flow diagram, then the
        product tour underneath it. Both are visuals, not prose. */}
    <div class="mt-14 stage-well stage-well--scenic hero-rise" style="--d:0.28s">
      <div class="hero-flow" id="hero-flow" aria-label="A request flowing through the gateway to a provider, then hash-chained into the audit ledger">
        <button class="flow-node" type="button" data-state="Every call enters through one gateway.">
          <span class="flow-node-glyph" aria-hidden="true"><Icon name="agent" /></span>
          <span class="flow-node-label">Agent</span>
        </button>
        <div class="flow-line"><span class="flow-pulse" style="--delay:0s"></span></div>
        <button class="flow-node flow-node--gw" type="button" data-state="Recorded in full fidelity — your keys, 0% markup.">
          <span class="flow-node-glyph" aria-hidden="true"><Icon name="gateway" /></span>
          <span class="flow-node-label">Gateway</span>
        </button>
        <div class="flow-line"><span class="flow-pulse" style="--delay:0.9s"></span></div>
        <button class="flow-node" type="button" data-state="Routed to any of 150+ providers, one wire format.">
          <span class="flow-node-glyph" aria-hidden="true"><Icon name="provider" /></span>
          <span class="flow-node-label">Provider</span>
        </button>
      </div>
      <p class="hero-flow-readout" id="hero-flow-readout" aria-live="polite">Hover a step to see it recorded.</p>

      <div class="mt-6 frame frame--media" id="hero-stage">
        <div class="frame-bar">
          <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="frame-title">tracelane — replay</span>
        </div>
        <div class="frame-body" style="position:relative">
          <video id="hero-video" class="stage-video" poster="/tracelane-intro-v6-poster.jpg" playsinline preload="none">
            <source src="/tracelane-intro-v6.mp4" type="video/mp4" />
          </video>
          <button class="stage-overlay" id="hero-play" type="button" aria-label="Play the Tracelane tour with sound">
            <span class="play" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>

  {/* ===== Provider rail ===== */}
  <section class="panel">
    <h2 class="eyebrow eyebrow--center w-full mb-6">150+ providers, one canonical wire format</h2>
    <div class="provider-rail reveal">
      {providers.map((p) => <div class="tile">{p}</div>)}
    </div>
  </section>

  {/* ===== Why agent failures stay invisible — icon chips, not paragraphs ===== */}
  <section id="why" class="panel">
    <div class="reveal section-head">
      <p class="eyebrow mb-4">The problem</p>
      <h2 class="display-lg text-fg">Agents fail without crashing.</h2>
    </div>
    <div class="mt-10 flex flex-wrap gap-3 reveal-group">
      <div class="chip">
        <span class="chip-glyph" aria-hidden="true"><Icon name="drift" dot={false} /></span>
        State drift compounds
      </div>
      <div class="chip">
        <span class="chip-glyph" aria-hidden="true"><Icon name="check" dot={false} /></span>
        A 200 doesn't mean it worked
      </div>
      <div class="chip">
        <span class="chip-glyph" aria-hidden="true"><Icon name="tool" dot={false} /></span>
        Every tool call is code running on your behalf
      </div>
    </div>
  </section>

  {/* ===== Record / Replay / Prove — the 3-step how-it-works ===== */}
  <section id="what" class="panel">
    <div class="reveal section-head">
      <p class="eyebrow mb-4">How it works</p>
      <h2 class="display-lg text-fg">Record. Replay. Prove.</h2>
      <p class="lede">One Rust binary. Open core, Apache 2.0.</p>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-3 reveal-group cards-hover">
      <article class="glass p-7 step-card">
        <span class="step-num" aria-hidden="true">1</span>
        <div class="feat-glyph" aria-hidden="true"><Icon name="record" size={20} /></div>
        <h3 class="card-title">Record</h3>
        <p class="card-body">Every call, full fidelity, your keys.</p>
      </article>
      <article class="glass p-7 step-card">
        <span class="step-num" aria-hidden="true">2</span>
        <div class="feat-glyph" aria-hidden="true"><Icon name="replay" size={20} dot={false} /></div>
        <h3 class="card-title">Replay</h3>
        <p class="card-body">Step to the exact call that broke.</p>
      </article>
      <article class="glass p-7 step-card">
        <span class="step-num" aria-hidden="true">3</span>
        <div class="feat-glyph" aria-hidden="true"><Icon name="prove" size={20} dot={false} /></div>
        <h3 class="card-title">Prove</h3>
        <p class="card-body">Hash-chained, signed, verifiable offline.</p>
      </article>
    </div>
  </section>

  {/* ===== Benchmarks — measured gateway overhead, not a claimed number ===== */}
  <section id="benchmarks" class="panel">
    <div class="reveal section-head">
      <p class="eyebrow mb-4">Measured, not claimed</p>
      <h2 class="display-lg text-fg">2ms added at p50. 4ms at p95. 5ms at p99.</h2>
      <p class="lede">
        Gateway overhead on top of the model call, with capture on — measured with
        LiteLLM's own open <a href="https://github.com/BerriAI/ai-gateway-bench" class="link-accent" rel="noopener">AIGatewayBench</a> harness,
        not one we wrote ourselves.
      </p>
    </div>

    <div class="mt-10 reveal">
      <div class="bench-chart" aria-hidden="true">
        {benchRows.map((g) => (
          <div class={`bench-row${g.highlight ? " bench-row--highlight" : ""}`}>
            <div class="bench-row-head">
              <span class="bench-name">
                {g.name}
                {g.highlight && <span class="bench-tag">tracelane</span>}
              </span>
              <span class="bench-version">
                {g.version ?? "—"}
                {g.footnote === "bifrost" && <sup>&nbsp;†</sup>}
              </span>
            </div>
            {g.run2 ? (
              <div class="bench-bars">
                {(["p50", "p95", "p99"] as const).map((k) => (
                  <div class="bench-bar-line">
                    <span class="bench-bar-label">{k}</span>
                    <div class="bench-bar-track" aria-label={`${g.name} ${k}: ${g.run2![k]} milliseconds`}>
                      <div class="bench-bar-fill" style={`width:${benchPct(g.run2![k])}`}></div>
                    </div>
                    <span class="bench-bar-value">{g.run2![k]} ms</span>
                  </div>
                ))}
              </div>
            ) : (
              <p class="bench-not-measured">not measured&nbsp;<sup>‡</sup></p>
            )}
            {g.run1 && g.run2 && (g.run1.p50 !== g.run2.p50 || g.run1.p95 !== g.run2.p95 || g.run1.p99 !== g.run2.p99) && (
              <p class="bench-run1">run 1: {g.run1.p50} / {g.run1.p95} / {g.run1.p99} ms</p>
            )}
          </div>
        ))}
      </div>

      {/* Same numbers, as a real table, for anyone not looking at the bars.

          `sr-only` GOES ON THE WRAPPER, NEVER ON THE <table>. A table's used
          width is its auto table layout, so `sr-only`'s `width: 1px` is only a
          suggestion it ignores — this table laid out at 938px and, being
          absolutely positioned, pushed the document's scrollable width to 954px
          on a 390px phone. `html/body { overflow-x: clip }` hid that from a
          desktop Chromium (`scrollWidth` read 390), but iOS Safari computes its
          minimum zoom scale from the content width, so pinch-zooming out on the
          real page showed the content in the left 41% and 564px of white to the
          right. A block wrapper has no such exemption and collapses to 1px.
          Guarded by `check-sr-only-tables.py`. */}
      <div class="sr-only">
      <table>
        <caption>Gateway overhead in milliseconds added over a direct call to the mock upstream, run 2 (run 1 in parentheses where it differs)</caption>
        <thead>
          <tr><th scope="col">Gateway</th><th scope="col">Version</th><th scope="col">p50</th><th scope="col">p95</th><th scope="col">p99</th><th scope="col">Peak RSS</th></tr>
        </thead>
        <tbody>
          {benchRows.map((g) => (
            <tr>
              <th scope="row">{g.name}</th>
              <td>{g.version ?? "not measured"}</td>
              <td>{g.run2 ? `${g.run2.p50} ms${g.run1 && g.run1.p50 !== g.run2.p50 ? ` (run 1: ${g.run1.p50} ms)` : ""}` : "not measured"}</td>
              <td>{g.run2 ? `${g.run2.p95} ms${g.run1 && g.run1.p95 !== g.run2.p95 ? ` (run 1: ${g.run1.p95} ms)` : ""}` : "not measured"}</td>
              <td>{g.run2 ? `${g.run2.p99} ms${g.run1 && g.run1.p99 !== g.run2.p99 ? ` (run 1: ${g.run1.p99} ms)` : ""}` : "not measured"}</td>
              <td>{g.rssMb ? `${g.rssMb} MB${g.rssNote ? ` (${g.rssNote})` : ""}` : "not measured"}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </div>

    <div class="mt-8 reveal">
      <p class="eyebrow mb-3">Peak memory (RSS), gateway process only</p>
      <div class="bench-rss-row">
        {benchRows.filter((g) => g.rssMb).map((g) => (
          <span><b>{g.name}</b> {g.rssMb} MB{g.rssNote ? ` (${g.rssNote})` : ""}</span>
        ))}
      </div>
    </div>

    <p class="mt-8 text-sm text-fg-dim bench-footnotes">
      Direct-to-mock baseline (already subtracted from every figure above): 1 / 2 / 3 ms p50/p95/p99.
      Host: one Hetzner CCX23 (4 vCPU, 16 GB). 16 concurrent clients, 30 seconds, two runs.<br />
      † Bifrost via <code>npx -y @maximhq/bifrost</code>, both runs — its version string is only
      emitted on first install, so run 2's CSV records it as "unknown"; v2.0.0 is from run 1.<br />
      ‡ LiteLLM Rust: as of 2026-09-07 no public build exists — the harness's own notes build it
      from a private branch on LiteLLM's machine. We'll run it when one is published.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <code class="bench-repro">bash bench/gateway/aigatewaybench/run.sh</code>
      <a href="https://docs.tracelane.dev/benchmarks" class="link-accent">Full method, caveats and the raw CSVs →</a>
    </div>

    
  </section>

  <CompareTable />

  {/* ===== Audit ledger — the dark band: copy left, terminal frame right ===== */}
  <section id="audit" class="band band--dark">
    <div class="band-inner">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)] lg:gap-16 lg:items-center reveal">
        <div>
          <p class="eyebrow mb-4">The audit ledger</p>
          <h2 class="display-lg text-fg">Every run. On the record. <span class="grad-text-warm">Provably.</span></h2>
          <p class="mt-5 text-fg-muted leading-relaxed" style="text-wrap:pretty">
            SHA-256 hash-chained, Ed25519-signed — verify any trace offline.
          </p>
          <p class="mt-6"><a href="/security" class="link-accent">Full security posture →</a></p>

          <div class="chain" aria-hidden="true">
            <div class="chain-node"><b>event</b><span>sha-256</span></div>
            <div class="chain-link"></div>
            <div class="chain-node"><b>event</b><span>sha-256</span></div>
            <div class="chain-link"></div>
            <div class="chain-node"><b>event</b><span>sha-256</span></div>
            <div class="chain-link"></div>
            <div class="chain-node chain-node--root"><b>merkle root</b><span>ed25519</span></div>
          </div>
        </div>

        <div class="stage-well stage-well--dark">
          <div class="frame frame--dark">
            <div class="frame-bar">
              <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="frame-title">tlane — verify</span>
            </div>
            <div class="frame-body">
<pre class="term"><code><span class="c"># verify any trace offline — no trust in us required</span>
<span class="p">$</span> tlane verify &lt;trace-id&gt;
<span class="ok">✓</span> signature valid (Ed25519, Merkle root)
<span class="ok">✓</span> hash chain unbroken (SHA-256)
<span class="ok">✓</span> tamper-evident: yes <span class="caret">&nbsp;</span></code></pre>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 grid gap-4 md:grid-cols-3 text-sm reveal-group cards-hover">
        <div class="glass p-6">
          <p class="card-index">eu ai act</p>
          <p class="card-body text-sm">Article 12 export pack — full audit trail for high-risk AI systems. Annex III enforcement provisionally deferred to Dec 2, 2027 (Digital Omnibus political agreement, May 7, 2026; pending formal adoption — <a href="https://www.whitecase.com/insight-alert/eu-agrees-digital-omnibus-deal-simplify-ai-rules" class="link-accent" rel="noopener">details</a>); the ledger is available today.</p>
        </div>
        <div class="glass p-6">
          <p class="card-index">india dpdp</p>
          <p class="card-body text-sm">Phase II enforcement Nov 13, 2026. Tracelane enforces no per-tenant storage region today; region pinning is on the roadmap. The audit ledger has no expiry clock — it is kept for the life of the ledger.</p>
        </div>
        <div class="glass p-6">
          <p class="card-index">hipaa</p>
          <p class="card-body text-sm">No signed BAA today, so do not route PHI through the hosted gateway. Prompt and response text is not stored unless we enable capture for your workspace. Inline redaction (Team and above) masks structured identifiers only — card numbers, SSNs, emails, E.164 phone numbers and secret-shaped strings — never names, addresses or free-text clinical detail. Provider keys are envelope-encrypted.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ===== Migration — copy left, two overlapping frames right ===== */}
  <section id="migrate" class="panel">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)] lg:gap-16 lg:items-center reveal">
      <div>
        <p class="eyebrow mb-4">Migration</p>
        <h2 class="display-md text-fg">Moving off a tool that changed hands or changed its terms?</h2>
        <p class="mt-5 text-fg-muted leading-relaxed" style="text-wrap:pretty">
          One command rewrites your config. Nothing leaves your infrastructure.
        </p>
      </div>

      <div class="stage-well stage-well--scenic">
        <div class="frame-stack">
          <div class="frame frame--dark">
            <div class="frame-bar">
              <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="frame-title">tlane — migrate helicone</span>
            </div>
            <div class="frame-body">
<pre class="term"><code><span class="c"># rewrites HELICONE_* env vars, base URLs and custom</span>
<span class="c"># headers across your source tree — printed as a diff,</span>
<span class="c"># dry-run by default</span>
<span class="p">$</span> tlane migrate helicone</code></pre>
            </div>
          </div>

          <div class="frame frame-over">
            <div class="frame-bar">
              <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="frame-title">tlane — import-litellm</span>
            </div>
            <div class="frame-body">
<pre class="term" style="color:var(--color-fg)"><code><span class="c" style="color:var(--color-fg-dim)"># reads litellm_config.yaml, emits the</span>
<span class="c" style="color:var(--color-fg-dim)"># equivalent Tracelane config</span>
<span class="p">$</span> tlane import-litellm</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PricingTable />

  {/* ===== Trust ===== */}
  <section id="trust" class="panel">
    <div class="reveal section-head">
      <p class="eyebrow mb-4">Security posture</p>
      <h2 class="display-lg text-fg">Built for procurement reviews.</h2>
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 text-sm reveal-group cards-hover">
      <div class="glass p-6">
        <p class="card-index">release integrity</p>
        <p class="card-body text-sm">Sigstore Cosign keyless signing with attested build provenance. Trusted Publishing OIDC — no long-lived registry tokens.</p>
      </div>
      <div class="glass p-6">
        <p class="card-index">sbom</p>
        <p class="card-body text-sm">CycloneDX SBOM published with every release, verifiable from GitHub release artifacts.</p>
      </div>
      <div class="glass p-6">
        <p class="card-index">vuln scanning</p>
        <p class="card-body text-sm">gitleaks, cargo-deny and a critical-level dependency audit on every push; OSV-Scanner and Grype nightly and a Syft SBOM weekly on the public repository.</p>
      </div>
      <div class="glass p-6">
        <p class="card-index">pre-flight policy</p>
        <p class="card-body text-sm">Policy checks run inline at the gateway before the call leaves. Today: schema-violation + tool-definition-drift, fail-open. More on a published roadmap.</p>
      </div>
      <div class="glass p-6">
        <p class="card-index">transport</p>
        <p class="card-body text-sm">TLS 1.3 minimum. mTLS via SPIFFE/SPIRE for ingest. SSRF defense — RFC1918 + link-local denied.</p>
      </div>
      <div class="glass p-6">
        <p class="card-index">standards</p>
        <p class="card-body text-sm">OTel GenAI semconv — tracking the pre-execution judgment / negative-proof proposal (<a href="https://github.com/open-telemetry/semantic-conventions/issues/3244" class="link-accent" rel="noopener">#3244</a>).</p>
      </div>
    </div>
  </section>

  {/* ===== FAQ ===== */}
  <section id="faq" class="panel">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16">
      <div>
        <p class="eyebrow mb-4">FAQ</p>
        <h2 class="display-lg text-fg">Frequently asked.</h2>
      </div>
      <div class="reveal">
        <details class="faq-row">
          <summary class="text-fg">What is Tracelane?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">An open-source (Apache 2.0) flight recorder for AI agents: a universal Rust LLM gateway, full-fidelity OpenTelemetry observability, and a tamper-evident audit ledger. Each event is SHA-256 hash-chained and the Merkle root is Ed25519-signed every 100 events, so any trace can be verified offline.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">How is it different from Helicone, LangSmith or Langfuse?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">Tracelane unifies the gateway, observability, pre-flight policy and a tamper-evident audit ledger in one Rust binary. Helicone, Langfuse and LangSmith are observability-first — you bring your own gateway and guardrails. Licensing: Tracelane is Apache 2.0 core with a published self-host path; Helicone's gateway is GPL-3.0, Arize Phoenix is ELv2 (no SaaS resale), LangSmith is closed-source. The audit ledger is hash-chained and Ed25519-signed — we are not aware of another product in this category that offers cryptographic audit-log integrity at the trace level.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">What about LangSmith Engine?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">LangSmith Engine (May 13, 2026) clusters production failures after they happen and drafts pull requests to fix them; Tracelane's pre-flight policy checks flag failure modes at the gateway. Engine is locked to the LangSmith trace surface and LangChain-managed inference keys per LangChain's terms of service; Tracelane is neutral OTel ingest with 0% BYOK markup across 150+ providers. Different layer of the agent reliability stack.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">Is Tracelane really open source?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">Yes. The core (Rust gateway, ingest workers, observability backend, pre-flight layer, CLI, SDKs, audit verifiers) is Apache 2.0. The <code class="font-mono text-sm">/spec</code> directory is CC0. Paid features are gated by the workspace_entitlements table at the application layer, not by a license-string compare.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">Which providers are supported?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">150+ providers today — 6 native adapters (Anthropic, Google Gemini, Google Vertex, AWS Bedrock, Azure OpenAI, Cohere) plus OpenAI and any OpenAI-compatible endpoint, including Together, Fireworks, Groq, OpenRouter, DeepSeek, xAI, and Mistral. One canonical wire format across all of them.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">Does Tracelane support EU AI Act Article 12?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">The Tamper-Evident Agent Ledger (SHA-256 hash chain, Ed25519-signed Merkle root, Rekor anchoring, self-verification) is included on every tier, free and paid — no add-on to buy. The Article 12 evidence export and seven-year ledger retention are included on Enterprise. Tracelane enforces no per-tenant storage region, signs no BAA, and makes no regulatory-conformance claim. EU AI Act Annex III obligations were originally scheduled for Aug 2, 2026; the Digital Omnibus political agreement (May 7, 2026) provisionally deferred enforcement to Dec 2, 2027, pending formal adoption (<a href="https://www.whitecase.com/insight-alert/eu-agrees-digital-omnibus-deal-simplify-ai-rules" class="link-accent" rel="noopener">details</a>). The ledger ships now so regulated buyers can build audit history before binding enforcement.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">What's the latency overhead?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">Measured, not targeted: <strong>2ms p50, 4ms p95, 5ms p99</strong> of added latency (excluding provider time), taken with LiteLLM's open AIGatewayBench harness on a 4 vCPU host with capture on, two runs, alongside Bifrost, Portkey and LiteLLM — see the <a class="underline" href="#benchmarks">full breakdown above</a> or the <a class="underline" href="https://docs.tracelane.dev/benchmarks">benchmark page</a> for method, caveats and the raw CSVs. The pre-flight policy layer is still an engineering target (p99 &lt;50ms on commodity CPU).</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">Can I self-host?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">Yes. Docker Compose for development, Helm chart for production. The full ClickHouse + R2 stack runs on a single small Hetzner node. See the <a href="https://docs.tracelane.dev/self-hosting" class="link-accent" rel="noopener">self-hosting guide</a>.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">Is Tracelane available now?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">Yes — V1 is live. Start free at <a href="https://app.tracelane.dev/sign-in" class="link-accent">app.tracelane.dev</a>, or self-host the Apache 2.0 core.</p>
        </details>
      </div>
    </div>
  </section>

  {/* ===== Notify ===== */}
  <section id="notify" class="panel">
    <div class="stage-well stage-well--scenic" style="padding-block:clamp(3rem,7vw,5.5rem)">
      <div class="max-w-2xl mx-auto text-center">
        <p class="eyebrow eyebrow--center w-full mb-4">Stay close</p>
        <h2 class="display-md text-fg">Get product updates.</h2>
        <p class="mt-4 lede mx-auto text-center">One email when something ships. Unsubscribe in one click.</p>
        <form id="notify-form" class="mt-8 flex flex-col sm:flex-row gap-2.5 max-w-lg mx-auto" method="POST" action="/api/notify">
          <label for="email" class="sr-only">email address</label>
          <input id="email" type="email" name="email" required autocomplete="email" placeholder="you@company.com" class="field" />
          <button type="submit" class="btn-primary">Keep me posted</button>
        </form>
        <p id="notify-status" class="mt-4 text-sm text-fg-subtle min-h-[1.25rem]" aria-live="polite"></p>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // hero video stage — reveal native player on click
  (function () {
    var play = document.getElementById("hero-play");
    var vid = document.getElementById("hero-video");
    if (!play || !vid) return;
    play.addEventListener("click", function () {
      play.style.display = "none";
      vid.currentTime = 0;
      vid.muted = false;
      vid.controls = true;
      var p = vid.play(); if (p && p.catch) p.catch(function () {});
    });
    vid.addEventListener("ended", function () {
      vid.controls = false;
      play.style.display = "";
    });
  })();

  // hero request-flow diagram — hover/focus a node, the readout line updates
  // and the connecting pulse highlights. No libraries; CSS keyframes drive the
  // idle animation, this only swaps text + an "active" class on hover/focus.
  (function () {
    var flow = document.getElementById("hero-flow");
    var readout = document.getElementById("hero-flow-readout");
    if (!flow || !readout) return;
    var nodes = flow.querySelectorAll(".flow-node");
    var defaultText = readout.textContent;
    nodes.forEach(function (node) {
      var setActive = function () {
        flow.classList.add("is-focused");
        node.classList.add("is-active");
        readout.textContent = node.dataset.state || defaultText;
      };
      var clearActive = function () {
        flow.classList.remove("is-focused");
        node.classList.remove("is-active");
        readout.textContent = defaultText;
      };
      node.addEventListener("mouseenter", setActive);
      node.addEventListener("focus", setActive);
      node.addEventListener("mouseleave", clearActive);
      node.addEventListener("blur", clearActive);
    });
  })();

  // scroll reveal lives in Base.astro — it is layout behaviour, not homepage behaviour.

  // notify form
  (function () {
    var form = document.getElementById("notify-form");
    var status = document.getElementById("notify-status");
    if (!form || !status) return;
    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      var emailInput = document.getElementById("email");
      var submitBtn = form.querySelector("button[type='submit']");
      if (!emailInput || !submitBtn) return;
      var email = emailInput.value.trim();
      status.textContent = "Sending...";
      submitBtn.disabled = true;
      try {
        var res = await fetch("/api/notify", {
          method: "POST",
          body: JSON.stringify({ email: email }),
          headers: { "Content-Type": "application/json" },
        });
        if (res.ok) { status.textContent = "You're on the list. We'll email you when something ships."; form.reset(); }
        else { var data = await res.json().catch(function () { return {}; }); status.textContent = data.error || "Something went wrong. Try again."; }
      } catch (err) { status.textContent = "Network error. Try again."; }
      finally { submitBtn.disabled = false; }
    });
  })();
</script>
