---
/**
 * tracelane.dev homepage.
 *
 * REBUILT 2026-08-24 against cursor.com's layout language (founder instruction).
 * The rhythm is theirs: an understated hero over a framed product stage, a logo
 * garden, then alternating copy/stage rows, a card grid, and hairline FAQ rows.
 *
 * NOTHING FACTUAL CHANGED. Every number, price, date, citation, link and copy
 * lock is the one that was already on the page — the prose is shorter, not
 * different. The two terminal frames render text that already existed here
 * verbatim (`tlane verify` output; the `tlane migrate helicone` /
 * `tlane import-litellm` commands and what the copy says they do). No trace id,
 * latency, cost or row count is invented anywhere on this page, which is why the
 * frames show a CLI and the shipped demo video rather than a mocked dashboard.
 */
import Base from "../layouts/Base.astro";
import PricingTable from "../components/PricingTable.astro";

const providers = [
  "OpenAI",
  "Anthropic",
  "Google",
  "Mistral",
  "Llama",
  "Bedrock",
  "Groq",
  "150+ providers",
];
---

<Base>
  {/* ===== Hero ===== */}
  <section class="panel" style="padding-top:clamp(3rem,7vw,5.5rem)">
    <div class="max-w-prose text-left">
      <span class="badge hero-rise" style="--d:0s"><span class="dot"></span>open source · self-host · your keys, 0% markup</span>

      <h1 class="mt-6 text-2xl sm:text-3xl text-fg headline-in" style="--d:0.06s">
        The <span class="grad-text">flight recorder</span> for AI agents
      </h1>

      <p class="mt-5 text-base text-fg-muted leading-relaxed hero-rise" style="--d:0.12s">
        Agents fail without crashing — every call returns a clean 200 while the run drifts off course.
        Tracelane records the whole execution path to a tamper-evident, cryptographically signed ledger.
        See where it drifted. Prove what happened.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3 hero-rise" style="--d:0.18s">
        <a href="https://app.tracelane.dev/sign-in" class="btn-primary">Start free <span aria-hidden="true">→</span></a>
        <a href="https://github.com/tracelane" class="btn-secondary" rel="me noopener">GitHub</a>
        <span class="text-sm text-fg-dim">no credit card · apache-2.0 core</span>
      </div>
    </div>

    {/* The stage: a scenic well with the product frame inset on it. */}
    <div class="mt-12 stage-well stage-well--scenic hero-rise" style="--d:0.26s">
      <div class="frame frame--media" id="hero-stage">
        <div class="frame-bar">
          <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="frame-title">tracelane — replay</span>
        </div>
        <div class="frame-body" style="position:relative">
          <video id="hero-video" class="stage-video" poster="/tracelane-demo-v4-poster.jpg" playsinline preload="none">
            <source src="/tracelane-demo-v4.mp4" type="video/mp4" />
          </video>
          <button class="stage-overlay" id="hero-play" type="button" aria-label="Play the Tracelane tour with sound">
            <span class="play" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>

  {/* ===== Provider garden ===== */}
  <section class="panel">
    <h2 class="eyebrow text-center mb-6">150+ providers, one canonical wire format</h2>
    <div class="tile-grid reveal">
      {providers.map((p) => <div class="tile">{p}</div>)}
    </div>
  </section>

  {/* ===== Why agent failures stay invisible ===== */}
  <section id="why" class="panel">
    <div class="reveal max-w-3xl">
      <h2 class="text-3xl sm:text-4xl text-fg">Why agent failures stay invisible</h2>
    </div>
    <div class="mt-10 grid gap-2.5 md:grid-cols-3 reveal-group cards-hover">
      <article class="glass p-7">
        <h3 class="text-lg text-fg">State drift compounds</h3>
        <p class="mt-3 text-fg-muted leading-relaxed">A bad tool output at step 2 corrupts every step after it. The model keeps going — confidently, further from the goal.</p>
      </article>
      <article class="glass p-7">
        <h3 class="text-lg text-fg">Success codes lie</h3>
        <p class="mt-3 text-fg-muted leading-relaxed">A 200 says nothing about whether the state is still valid three steps later. Tracelane reconstructs the causal path, not just the request log.</p>
      </article>
      <article class="glass p-7">
        <h3 class="text-lg text-fg">Tools are an open surface</h3>
        <p class="mt-3 text-fg-muted leading-relaxed">Every tool call is code running on your behalf. The ledger records exactly what ran.</p>
      </article>
    </div>
  </section>

  {/* ===== Record / Replay / Prove ===== */}
  <section id="what" class="panel">
    <div class="reveal max-w-3xl">
      <h2 class="text-3xl sm:text-4xl text-fg">Everything your agent does, on the record.</h2>
      <p class="mt-4 text-base text-fg-muted">Three things, one Rust binary. Open core, Apache 2.0.</p>
    </div>
    <div class="mt-10 grid gap-2.5 md:grid-cols-3 reveal-group cards-hover">
      <article class="glass p-7">
        <div class="feat-glyph" aria-hidden="true"><span class="glyph-eq"><i></i><i></i><i></i><i></i><i></i></span></div>
        <p class="font-mono text-xs text-pop mb-2 lowercase">01 — record</p>
        <h3 class="text-lg text-fg">Universal gateway</h3>
        <p class="mt-3 text-fg-muted leading-relaxed">One endpoint in front of every model. Your keys, 0% markup, bounded overhead — every call captured in full fidelity.</p>
      </article>
      <article class="glass p-7">
        <div class="feat-glyph" aria-hidden="true"><svg class="glyph-replay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v5h-5"/></svg></div>
        <p class="font-mono text-xs text-pop mb-2 lowercase">02 — replay</p>
        <h3 class="text-lg text-fg">Replay the failure</h3>
        <p class="mt-3 text-fg-muted leading-relaxed">Step-level trace of prompts, tool calls, latency and cost — down to the call that broke, and whether you've seen it before.</p>
      </article>
      <article class="glass p-7">
        <div class="feat-glyph" aria-hidden="true"><svg class="glyph-prove" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg></div>
        <p class="font-mono text-xs text-pop mb-2 lowercase">03 — prove</p>
        <h3 class="text-lg text-fg">Prove it</h3>
        <p class="mt-3 text-fg-muted leading-relaxed">A tamper-evident ledger — SHA-256 hash chain, Ed25519-signed Merkle root — anyone can verify offline. Logs you can't argue with.</p>
      </article>
    </div>
  </section>

  {/* ===== Audit ledger — copy left, terminal frame right ===== */}
  <section id="audit" class="panel">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-12 lg:items-center reveal">
      <div>
        <p class="eyebrow mb-3">The audit ledger</p>
        <h2 class="text-3xl text-fg">Every run. On the record. <span class="grad-text">Provably.</span></h2>
        <p class="mt-4 text-fg-muted leading-relaxed">
          Each event is hash-chained with SHA-256. Every 100 events, the Merkle root is signed with
          Ed25519. Verify the whole chain offline — tampering means breaking SHA-256 or forging a
          signature, not editing a row.
        </p>
        <p class="mt-5"><a href="/security" class="link-accent">Full security posture →</a></p>
      </div>

      <div class="stage-well stage-well--dark">
        <div class="frame frame--dark">
          <div class="frame-bar">
            <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="frame-title">tlane — verify</span>
          </div>
          <div class="frame-body">
<pre class="term"><code><span class="c"># verify any trace offline — no trust in us required</span>
<span class="p">$</span> tlane verify &lt;trace-id&gt;
<span class="ok">✓</span> signature valid (Ed25519, Merkle root)
<span class="ok">✓</span> hash chain unbroken (SHA-256)
<span class="ok">✓</span> tamper-evident: yes <span class="caret">&nbsp;</span></code></pre>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-2.5 grid gap-2.5 md:grid-cols-3 text-sm reveal-group cards-hover">
      <div class="glass p-6">
        <p class="font-mono text-xs text-fg-dim lowercase">eu ai act</p>
        <p class="mt-3 text-fg-muted leading-relaxed">Article 12 export pack — full audit trail for high-risk AI systems. Annex III enforcement provisionally deferred to Dec 2, 2027 (Digital Omnibus political agreement, May 7, 2026; pending formal adoption — <a href="https://www.whitecase.com/insight-alert/eu-agrees-digital-omnibus-deal-simplify-ai-rules" class="link-accent" rel="noopener">details</a>); the ledger is available today.</p>
      </div>
      <div class="glass p-6">
        <p class="font-mono text-xs text-fg-dim lowercase">india dpdp</p>
        <p class="mt-3 text-fg-muted leading-relaxed">Phase II enforcement Nov 13, 2026. Tracelane enforces no per-tenant storage region today; region pinning is on the roadmap. The audit ledger has no expiry clock — it is kept for the life of the ledger.</p>
      </div>
      <div class="glass p-6">
        <p class="font-mono text-xs text-fg-dim lowercase">hipaa</p>
        <p class="mt-3 text-fg-muted leading-relaxed">BAA available on Business tier. PII redaction inline. Provider keys envelope-encrypted.</p>
      </div>
    </div>
  </section>

  {/* ===== Migration — copy left, two overlapping frames right ===== */}
  <section id="migrate" class="panel">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-12 lg:items-center reveal">
      <div>
        <p class="eyebrow mb-3">Migration</p>
        <h2 class="text-3xl text-fg">Moving off a tool that got acquired or breached?</h2>
        <p class="mt-4 text-fg-muted leading-relaxed">
          Migration is forward re-instrumentation: we rewrite your config and SDK wiring to point at
          Tracelane. No data leaves your infrastructure; your history stays where it is.
        </p>
        <p class="mt-4 text-sm text-fg-muted leading-relaxed">
          New runs land in Tracelane the moment you apply the diff; historical traces stay in the tool
          you came from. LiteLLM is a drop-in gateway replacement on a Rust request path — with
          Sigstore-signed releases, attested build provenance and Trusted Publishing OIDC, so there are
          no long-lived registry tokens.
        </p>
      </div>

      <div class="stage-well stage-well--scenic">
        <div class="frame-stack">
          <div class="frame frame--dark">
            <div class="frame-bar">
              <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="frame-title">tlane — migrate helicone</span>
            </div>
            <div class="frame-body">
<pre class="term"><code><span class="c"># rewrites HELICONE_* env vars, base URLs and custom</span>
<span class="c"># headers across your source tree — printed as a diff,</span>
<span class="c"># dry-run by default</span>
<span class="p">$</span> tlane migrate helicone</code></pre>
            </div>
          </div>

          <div class="frame frame-over">
            <div class="frame-bar">
              <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="frame-title">tlane — import-litellm</span>
            </div>
            <div class="frame-body">
<pre class="term" style="color:var(--color-fg)"><code><span class="c" style="color:var(--color-fg-dim)"># reads litellm_config.yaml, emits the</span>
<span class="c" style="color:var(--color-fg-dim)"># equivalent Tracelane config</span>
<span class="p">$</span> tlane import-litellm</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PricingTable />

  {/* ===== Trust ===== */}
  <section id="trust" class="panel">
    <div class="reveal max-w-3xl">
      <p class="eyebrow mb-3">Security posture</p>
      <h2 class="text-3xl sm:text-4xl text-fg">Built for procurement reviews.</h2>
    </div>
    <div class="mt-10 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3 text-sm reveal-group cards-hover">
      <div class="glass p-6">
        <p class="font-mono text-xs text-fg-dim lowercase">release integrity</p>
        <p class="mt-3 text-fg-muted leading-relaxed">Sigstore Cosign keyless signing with attested build provenance. Trusted Publishing OIDC — no long-lived registry tokens.</p>
      </div>
      <div class="glass p-6">
        <p class="font-mono text-xs text-fg-dim lowercase">sbom</p>
        <p class="mt-3 text-fg-muted leading-relaxed">CycloneDX SBOM published with every release, verifiable from GitHub release artifacts.</p>
      </div>
      <div class="glass p-6">
        <p class="font-mono text-xs text-fg-dim lowercase">vuln scanning</p>
        <p class="mt-3 text-fg-muted leading-relaxed">OSV-Scanner + Grype + Syft on every commit.</p>
      </div>
      <div class="glass p-6">
        <p class="font-mono text-xs text-fg-dim lowercase">pre-flight policy</p>
        <p class="mt-3 text-fg-muted leading-relaxed">Policy checks run inline at the gateway before the call leaves. Today: schema-violation + tool-definition-drift, fail-open. More on a published roadmap.</p>
      </div>
      <div class="glass p-6">
        <p class="font-mono text-xs text-fg-dim lowercase">transport</p>
        <p class="mt-3 text-fg-muted leading-relaxed">TLS 1.3 minimum. mTLS via SPIFFE/SPIRE for ingest. SSRF defense — RFC1918 + link-local denied.</p>
      </div>
      <div class="glass p-6">
        <p class="font-mono text-xs text-fg-dim lowercase">standards</p>
        <p class="mt-3 text-fg-muted leading-relaxed">OTel GenAI semconv — tracking the pre-execution judgment / negative-proof proposal (<a href="https://github.com/open-telemetry/semantic-conventions/issues/3244" class="link-accent" rel="noopener">#3244</a>).</p>
      </div>
    </div>
  </section>

  {/* ===== FAQ ===== */}
  <section id="faq" class="panel">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-12">
      <h2 class="text-3xl sm:text-4xl text-fg">Frequently asked.</h2>
      <div class="reveal">
        <details class="faq-row">
          <summary class="text-fg">What is Tracelane?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">An open-source (Apache 2.0) flight recorder for AI agents: a universal Rust LLM gateway, full-fidelity OpenTelemetry observability, and a tamper-evident audit ledger. Each event is SHA-256 hash-chained and the Merkle root is Ed25519-signed every 100 events, so any trace can be verified offline.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">How is it different from Helicone, LangSmith or Langfuse?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">Tracelane unifies the gateway, observability, pre-flight policy and a tamper-evident audit ledger in one Rust binary. Helicone, Langfuse and LangSmith are observability-first — you bring your own gateway and guardrails. Licensing: Tracelane is Apache 2.0 core with a published self-host path; Helicone's gateway is GPL-3.0 (corporate-procurement-hostile), Arize Phoenix is ELv2 (no SaaS resale), LangSmith is closed-source. The audit ledger is hash-chained and Ed25519-signed — no competitor in this category offers cryptographic audit-log integrity at the trace level.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">What about LangSmith Engine?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">LangSmith Engine (May 13, 2026) clusters production failures after they happen and drafts pull requests to fix them; Tracelane's pre-flight policy checks flag failure modes at the gateway. Engine is locked to the LangSmith trace surface and LangChain-managed inference keys per LangChain's terms of service; Tracelane is neutral OTel ingest with 0% BYOK markup across 150+ providers. Different layer of the agent reliability stack.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">Is Tracelane really open source?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">Yes. The core (Rust gateway, ingest workers, observability backend, pre-flight layer, CLI, SDKs, audit verifiers) is Apache 2.0. The <code class="font-mono text-sm">/spec</code> directory is CC0. Paid features are gated by the workspace_entitlements table at the application layer, not by a license-string compare.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">Which providers are supported?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">150+ providers today — 6 native adapters (Anthropic, Google Gemini, Google Vertex, AWS Bedrock, Azure OpenAI, Cohere) plus OpenAI and any OpenAI-compatible endpoint, including Together, Fireworks, Groq, OpenRouter, DeepSeek, xAI, and Mistral. One canonical wire format across all of them.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">Does Tracelane support EU AI Act Article 12?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">The Tamper-Evident Agent Ledger is a $999/mo add-on, available on any plan. The audit ledger (SHA-256 hash chain, Ed25519-signed Merkle root) and an Article 12 documentation pack are available today. Tracelane enforces no per-tenant storage region, signs no BAA, and makes no regulatory-conformance claim. EU AI Act Annex III obligations were originally scheduled for Aug 2, 2026; the Digital Omnibus political agreement (May 7, 2026) provisionally deferred enforcement to Dec 2, 2027, pending formal adoption (<a href="https://www.whitecase.com/insight-alert/eu-agrees-digital-omnibus-deal-simplify-ai-rules" class="link-accent" rel="noopener">details</a>). The ledger ships now so regulated buyers can build audit history before binding enforcement.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">What's the latency overhead?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">Gateway overhead targets p50 &lt;5ms, p95 &lt;15ms, p99 &lt;25ms (excluding provider time). Pre-flight policy layer targets p99 &lt;50ms on commodity CPU. These are engineering targets — measured numbers will publish as the Tracelane Reliability Benchmark v1.0.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">Can I self-host?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">Yes. Docker Compose for development, Helm chart for production. The full ClickHouse + R2 stack runs on a single small Hetzner node. See the <a href="https://docs.tracelane.dev/self-hosting" class="link-accent" rel="noopener">self-hosting guide</a>.</p>
        </details>

        <details class="faq-row">
          <summary class="text-fg">Is Tracelane available now?<span class="sign" aria-hidden="true">+</span></summary>
          <p class="text-fg-muted leading-relaxed">Yes — V1 is live. Start free at <a href="https://app.tracelane.dev/sign-in" class="link-accent">app.tracelane.dev</a>, or self-host the Apache 2.0 core.</p>
        </details>
      </div>
    </div>
  </section>

  {/* ===== Notify ===== */}
  <section id="notify" class="panel">
    <div class="stage-well" style="padding-block:clamp(2.5rem,6vw,4.5rem)">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl text-fg">Get product updates.</h2>
        <p class="mt-4 text-base text-fg-muted">Occasional email when something ships that changes how you use Tracelane. Unsubscribe in one click.</p>
        <form id="notify-form" class="mt-8 flex flex-col sm:flex-row gap-2.5 max-w-lg mx-auto" method="POST" action="/api/notify">
          <label for="email" class="sr-only">email address</label>
          <input id="email" type="email" name="email" required autocomplete="email" placeholder="you@company.com" class="field" />
          <button type="submit" class="btn-primary">Keep me posted</button>
        </form>
        <p id="notify-status" class="mt-4 text-sm text-fg-subtle min-h-[1.25rem]" aria-live="polite"></p>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // hero video stage — reveal native player on click
  (function () {
    var play = document.getElementById("hero-play");
    var vid = document.getElementById("hero-video");
    if (!play || !vid) return;
    play.addEventListener("click", function () {
      play.style.display = "none";
      vid.currentTime = 0;
      vid.muted = false;
      vid.controls = true;
      var p = vid.play(); if (p && p.catch) p.catch(function () {});
    });
    vid.addEventListener("ended", function () {
      vid.controls = false;
      play.style.display = "";
    });
  })();

  // scroll reveal lives in Base.astro — it is layout behaviour, not homepage behaviour.

  // notify form
  (function () {
    var form = document.getElementById("notify-form");
    var status = document.getElementById("notify-status");
    if (!form || !status) return;
    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      var emailInput = document.getElementById("email");
      var submitBtn = form.querySelector("button[type='submit']");
      if (!emailInput || !submitBtn) return;
      var email = emailInput.value.trim();
      status.textContent = "Sending...";
      submitBtn.disabled = true;
      try {
        var res = await fetch("/api/notify", {
          method: "POST",
          body: JSON.stringify({ email: email }),
          headers: { "Content-Type": "application/json" },
        });
        if (res.ok) { status.textContent = "You're on the list. We'll email you when something ships."; form.reset(); }
        else { var data = await res.json().catch(function () { return {}; }); status.textContent = data.error || "Something went wrong. Try again."; }
      } catch (err) { status.textContent = "Network error. Try again."; }
      finally { submitBtn.disabled = false; }
    });
  })();
</script>
