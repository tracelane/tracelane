---
import CompareTable from "../components/CompareTable.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
/**
 * tracelane.dev homepage.
 *
 * REBUILT 2026-08-24 against cursor.com's layout language (founder instruction),
 * RENOVATED 2026-09-02 for a premium finish, RE-UNIFIED 2026-09-04 onto the app's
 * shared Cupertino palette + a very-low-text pass (founder ruling, overriding the
 * 2026-09-03 "site keeps its warm palette" ruling — see `global.css`'s header).
 *
 * NOTHING FACTUAL CHANGED and no number was added. Every price, date, citation and
 * link is the one already on the page; the fact strip repeats claims made further
 * down. Paragraphs were CUT to a headline + one line per section — the sell now
 * happens in the visuals: an animated, hover-reactive request-flow diagram in the
 * hero (CSS + vanilla JS, no libraries, `prefers-reduced-motion` respected), icon
 * chips for the three failure modes, and Record → Replay → Prove as a 3-step
 * "how it works". The audit ledger's ledger-chain diagram and the two terminal
 * frames are unchanged — they were already visuals, not prose. FAQ and the
 * compliance/trust cards keep their full text: those are regulatory and licensing
 * claims under the honesty locks, not marketing copy, and trimming them would cut
 * the substantiating detail the locks require.
 */
import Base from "../layouts/Base.astro";
import PricingTable from "../components/PricingTable.astro";
import { SECTIONS } from "../data/product-data";

const providers = [
  "OpenAI",
  "Anthropic",
  "Google",
  "Mistral",
  "Llama",
  "Bedrock",
  "Groq",
  "191 providers",
];

/**
 * Gateway-overhead benchmark — every number here is copied verbatim from
 * `apps/docs/benchmarks.mdx` (2026-09-07 run). Do not hand-edit a number;
 * change the source file and copy it across. `run2` is what the chart bars
 * and headline show; `run1` is the second line under each row. `rssMb` is
 * peak RSS of the gateway process, run 2 unless `rssNote` says otherwise.
 * `footnote` keys the † / ‡ markers reproduced below the chart.
 */
type BenchMetric = { p50: number; p95: number; p99: number };
type BenchRow = {
  name: string;
  version: string | null;
  run1: BenchMetric | null;
  run2: BenchMetric | null;
  rssMb: number | null;
  rssNote?: string;
  highlight?: boolean;
  footnote?: "bifrost" | "litellm-rust";
};

const benchRows: BenchRow[] = [
  {
    name: "Tracelane",
    version: "1f3af9ad",
    run1: { p50: 2, p95: 4, p99: 5 },
    run2: { p50: 2, p95: 4, p99: 5 },
    rssMb: 14,
    highlight: true,
  },
  {
    name: "Bifrost",
    version: "v2.0.0",
    run1: { p50: 2, p95: 2, p99: 3 },
    run2: { p50: 2, p95: 2, p99: 3 },
    rssMb: 101,
    footnote: "bifrost",
  },
  {
    name: "Portkey (OSS)",
    version: "1.15.2",
    run1: { p50: 4, p95: 7, p99: 9 },
    run2: { p50: 3, p95: 5, p99: 8 },
    rssMb: 177,
    rssNote: "run 1; run 2 not sampled",
  },
  {
    name: "LiteLLM Python",
    version: "1.100.0",
    run1: { p50: 15, p95: 36, p99: 52 },
    run2: { p50: 14, p95: 34, p99: 47 },
    rssMb: 323,
  },
  {
    name: "LiteLLM Rust",
    version: null,
    run1: null,
    run2: null,
    rssMb: null,
    footnote: "litellm-rust",
  },
];

// Bar-width scale: the largest measured value across every row is LiteLLM
// Python's run-2 p99 (47ms); round up to a clean ceiling so bars have a
// little headroom rather than the longest bar touching the edge.
const benchScaleMax = 50;
const benchPct = (ms: number) => `${((ms / benchScaleMax) * 100).toFixed(1)}%`;
---

<Base>
  <section class="panel recorder-hero">
    <div class="hero-intro">
      <p class="hero-kicker"><span aria-hidden="true"></span> OPEN SOURCE INFRASTRUCTURE / AI AGENTS</p>
      <h1>The flight recorder<br /><span>for AI agents.</span></h1>
      <div class="hero-intro-copy">
        <p>Every call the hosted gateway admits, recorded in the ledger before it is dispatched. Every ledger record, verifiable.</p>
        <div class="hero-actions"><a href="https://app.tracelane.dev/sign-in" class="btn-primary">Start free <span aria-hidden="true">↗</span></a><a href="https://github.com/tracelane" class="hero-github" rel="me noopener">Explore the code <span aria-hidden="true">↗</span></a></div>
        <p class="hero-fineprint">No credit card · Apache-2.0 core<span class="hero-fineprint-sep" aria-hidden="true"> · </span><br /> Self-host · your keys, 0% markup</p>
      </div>
    </div>
      <div class="hero-film frame frame--media" id="hero-stage">
        <div class="frame-bar">
          <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="frame-title">tracelane — product tour</span>
        </div>
        <div class="frame-body" style="position:relative">
          <video id="hero-video" class="stage-video" width="1920" height="1080" playsinline preload="none">
            <source src="/tracelane-intro-v7.mp4" type="video/mp4" />
          </video>
          <button class="stage-overlay" id="hero-play" type="button" aria-label="Play the Tracelane tour with sound">
            <span class="film-cover-brand" aria-hidden="true"><Logo size={64} /></span>
            <span class="film-cover-title" aria-hidden="true">See the flight recorder in action.</span>
            <span class="play" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
            <span class="film-cover-label" aria-hidden="true">Watch the product tour</span>
          </button>
        </div>
      </div>

    <div class="hero-specs" aria-label="At a glance"><span><b>SHA-256</b> Hash chain</span><span><b>Ed25519</b> Signed Merkle root</span><span><b>191</b> Providers</span><span>Two Rust services — gateway and ingest — with ClickHouse and NATS.</span></div>
  </section>

  {/* ===== Provider rail ===== */}
  <section class="panel provider-section">
    <h2 class="eyebrow eyebrow--center w-full mb-6">191 providers, one canonical wire format</h2>
    <div class="provider-rail reveal">
      {providers.map((p) => <div class="tile">{p}</div>)}
    </div>
  </section>

  <section class="panel architecture-section" aria-label="Recording architecture">
    <div class="recorder-console">
      <div class="console-toolbar"><span><span class="console-mark" aria-hidden="true">◎</span> TRACELANE / RECORDING ARCHITECTURE</span><span>01 — ADMIT / RECORD / DISPATCH</span></div>
      <div class="console-body">
        <div class="console-pipeline">
          <div class="console-label">THE REQUEST PATH</div>
          <h2>From admitted call<br />to verifiable record.</h2>
      <div class="hero-flow" id="hero-flow" aria-label="A request flowing through the gateway to a provider, then hash-chained into the audit ledger">
        <button class="flow-node" type="button" data-state="Every call enters through one gateway.">
          <span class="flow-node-glyph" aria-hidden="true"><Icon name="agent" /></span>
          <span class="flow-node-label">Agent</span>
        </button>
        <div class="flow-line"><span class="flow-pulse" style="--delay:0s"></span></div>
        <button class="flow-node flow-node--gw" type="button" data-state="Recorded — model, tokens, cost and tool calls on every call; prompt and response text once capture is enabled for your workspace. Your keys, 0% markup.">
          <span class="flow-node-glyph" aria-hidden="true"><Icon name="gateway" /></span>
          <span class="flow-node-label">Gateway</span>
        </button>
        <div class="flow-line"><span class="flow-pulse" style="--delay:0.9s"></span></div>
        <button class="flow-node" type="button" data-state="Routed to any of 191 providers, one wire format.">
          <span class="flow-node-glyph" aria-hidden="true"><Icon name="provider" /></span>
          <span class="flow-node-label">Provider</span>
        </button>
      </div>
      <p class="hero-flow-readout" id="hero-flow-readout" aria-live="polite">Hover or tap a step to see it recorded.</p>

        </div>
        <div class="console-ledger">
      <div class="ledger-illustration" aria-label="Schematic ledger: recorded metadata is hash-chained and signed. This is an architecture illustration, not live data.">
        <div class="ledger-heading"><span>THE AUDIT LEDGER</span><span>Hash-chained</span></div>
        <div class="ledger-row"><span class="ledger-pin ledger-pin--model"></span><strong>Model calls</strong><span>Model · tokens · cost</span></div>
        <div class="ledger-row"><span class="ledger-pin ledger-pin--tool"></span><strong>Tool calls</strong><span>Recorded metadata</span></div>
        <div class="ledger-row"><span class="ledger-pin ledger-pin--agent"></span><strong>Signed Merkle root</strong><span>Ed25519</span></div>
        <div class="ledger-footer"><span aria-hidden="true">↳</span> Verify the record. Independently.</div>
      </div>
          <p class="console-note">A record you can inspect. A chain you can verify offline.</p>
        </div>
      </div>

    </div>
  </section>

  {/* ===== Why agent failures stay invisible — icon chips, not paragraphs ===== */}
  <section id="why" class="panel">
    <div class="reveal section-head">
      <p class="eyebrow mb-4">The problem</p>
      <h2 class="display-lg text-fg">Agents fail without crashing.</h2>
    </div>
    <div class="mt-10 flex flex-wrap gap-3 reveal-group">
      <div class="chip">
        <span class="chip-glyph" aria-hidden="true"><Icon name="drift" dot={false} /></span>
        State drift compounds
      </div>
      <div class="chip">
        <span class="chip-glyph" aria-hidden="true"><Icon name="check" dot={false} /></span>
        A 200 doesn't mean it worked
      </div>
      <div class="chip">
        <span class="chip-glyph" aria-hidden="true"><Icon name="tool" dot={false} /></span>
        Every tool call is code running on your behalf
      </div>
    </div>
  </section>

  {/* ===== Record / Replay / Prove — the 3-step how-it-works ===== */}
  <section id="what" class="panel">
    <div class="reveal section-head">
      <p class="eyebrow mb-4">How it works</p>
      <h2 class="display-lg text-fg">Record. Replay. Prove.</h2>
      <p class="lede">Two Rust services. Open core, Apache 2.0.</p>
    </div>
    <div class="workflow-grid reveal-group">
      <article class="glass p-7 step-card">
        <span class="workflow-index">01 / CAPTURE</span><div class="workflow-art capture-art" aria-hidden="true"><i>model</i><i>tokens</i><i>cost</i><span>Metadata → recorded</span></div>
        <div class="feat-glyph" aria-hidden="true"><Icon name="record" size={20} /></div>
        <h3 class="card-title">Record</h3>
        <p class="card-body">Metadata on every call by default; full prompt and response capture once it is enabled for your workspace — always on your own provider keys.</p>
      </article>
      <article class="glass p-7 step-card">
        <span class="workflow-index">02 / INSPECT</span><div class="workflow-art inspect-art" aria-hidden="true"><span>Stored spans</span><i></i><i></i><i></i></div>
        <div class="feat-glyph" aria-hidden="true"><Icon name="replay" size={20} dot={false} /></div>
        <h3 class="card-title">Replay</h3>
        <p class="card-body">Inspect the recorded calls to find what broke. Replay reads stored spans; it does not re-execute models or tools.</p>
      </article>
      <article class="glass p-7 step-card">
        <span class="workflow-index">03 / VERIFY</span><div class="workflow-art verify-art" aria-hidden="true"><span>Hash</span><i>→</i><span>Sign</span><i>→</i><span>Verify</span></div>
        <div class="feat-glyph" aria-hidden="true"><Icon name="prove" size={20} dot={false} /></div>
        <h3 class="card-title">Prove</h3>
        <p class="card-body">Hash-chained, signed, verifiable offline.</p>
      </article>
    </div>
    <nav class="explore reveal" aria-label="Explore the product">
      {SECTIONS.map((sec) => (
        <a href={`/product#${sec.slug}`} class="explore-link">
          <span class="explore-name">{sec.name} →</span>
          <span class="explore-head">{sec.headline}</span>
        </a>
      ))}
    </nav>
  </section>

  {/* ===== Benchmarks — measured gateway overhead, not a claimed number ===== */}
  <section id="benchmarks" class="panel">
    <div class="reveal section-head">
      <p class="eyebrow mb-4">Measured, not claimed</p>
      <h2 class="display-lg text-fg">2&nbsp;ms added at p50, 4&nbsp;ms at p95, 5&nbsp;ms at p99.</h2>
      <p class="lede">
        Gateway overhead on top of the model call, with span capture on — measured with
        LiteLLM's open <a href="https://github.com/BerriAI/ai-gateway-bench" class="link-accent" rel="noopener">AIGatewayBench</a> harness
        at a pinned commit, plus three published patches of ours (an OpenAI-route scenario and
        two mock-upstream timing fixes). Measured again with the production topology — a
        Postgres control plane, API-key authentication and the acknowledged audit-ledger write
        on every request — and within the same table.
      </p>
    </div>

    <div class="benchmark-visual reveal">
      <div class="bench-chart" aria-hidden="true">
        {benchRows.map((g) => (
          <div class={`bench-row${g.highlight ? " bench-row--highlight" : ""}`}>
            <div class="bench-row-head">
              <span class="bench-name">
                {g.name}
                {g.highlight && <span class="bench-tag">tracelane</span>}
              </span>
              <span class="bench-version">
                {g.version ?? "—"}
                {g.footnote === "bifrost" && <sup>&nbsp;†</sup>}
              </span>
            </div>
            {g.run2 ? (
              <div class="bench-bars">
                {(["p50", "p95", "p99"] as const).map((k) => (
                  <div class="bench-bar-line">
                    <span class="bench-bar-label">{k}</span>
                    <div class="bench-bar-track" aria-label={`${g.name} ${k}: ${g.run2![k]} milliseconds`}>
                      <div class="bench-bar-fill" style={`width:${benchPct(g.run2![k])}`}></div>
                    </div>
                    <span class="bench-bar-value">{g.run2![k]} ms</span>
                  </div>
                ))}
              </div>
            ) : (
              <p class="bench-not-measured">not measured&nbsp;<sup>‡</sup></p>
            )}
            {g.run1 && g.run2 && (g.run1.p50 !== g.run2.p50 || g.run1.p95 !== g.run2.p95 || g.run1.p99 !== g.run2.p99) && (
              <p class="bench-run1">run 1: {g.run1.p50} / {g.run1.p95} / {g.run1.p99} ms</p>
            )}
          </div>
        ))}
      </div>

      {/* Same numbers, as a real table, for anyone not looking at the bars.

          `sr-only` GOES ON THE WRAPPER, NEVER ON THE <table>. A table's used
          width is its auto table layout, so `sr-only`'s `width: 1px` is only a
          suggestion it ignores — this table laid out at 938px and, being
          absolutely positioned, pushed the document's scrollable width to 954px
          on a 390px phone. `html/body { overflow-x: clip }` hid that from a
          desktop Chromium (`scrollWidth` read 390), but iOS Safari computes its
          minimum zoom scale from the content width, so pinch-zooming out on the
          real page showed the content in the left 41% and 564px of white to the
          right. A block wrapper has no such exemption and collapses to 1px.
          Guarded by `check-sr-only-tables.py`. */}
      <div class="sr-only">
      <table>
        <caption>Gateway overhead in milliseconds added over a direct call to the mock upstream, run 2 (run 1 in parentheses where it differs)</caption>
        <thead>
          <tr><th scope="col">Gateway</th><th scope="col">Version</th><th scope="col">p50</th><th scope="col">p95</th><th scope="col">p99</th><th scope="col">Peak RSS</th></tr>
        </thead>
        <tbody>
          {benchRows.map((g) => (
            <tr>
              <th scope="row">{g.name}</th>
              <td>{g.version ?? "not measured"}</td>
              <td>{g.run2 ? `${g.run2.p50} ms${g.run1 && g.run1.p50 !== g.run2.p50 ? ` (run 1: ${g.run1.p50} ms)` : ""}` : "not measured"}</td>
              <td>{g.run2 ? `${g.run2.p95} ms${g.run1 && g.run1.p95 !== g.run2.p95 ? ` (run 1: ${g.run1.p95} ms)` : ""}` : "not measured"}</td>
              <td>{g.run2 ? `${g.run2.p99} ms${g.run1 && g.run1.p99 !== g.run2.p99 ? ` (run 1: ${g.run1.p99} ms)` : ""}` : "not measured"}</td>
              <td>{g.rssMb ? `${g.rssMb} MB${g.rssNote ? ` (${g.rssNote})` : ""}` : "not measured"}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </div>

    <div class="mt-8 reveal">
      <p class="eyebrow mb-3">Peak memory (RSS), gateway process only</p>
      <div class="bench-rss-row">
        {benchRows.filter((g) => g.rssMb).map((g) => (
          <span><b>{g.name}</b> {g.rssMb} MB{g.rssNote ? ` (${g.rssNote})` : ""}</span>
        ))}
      </div>
    </div>

    <details class="mt-8 bench-details">
      <summary class="text-sm text-fg-muted">Method and caveats</summary>
    <p class="mt-3 text-sm text-fg-dim bench-footnotes">
      Direct-to-mock baseline (already subtracted from every figure above): 1 / 2 / 3 ms p50/p95/p99.
      Host: one Hetzner CCX23 (4 vCPU, 16 GB). 16 concurrent clients, 30 seconds, two runs.<br />
      † Bifrost via <code>npx -y @maximhq/bifrost</code>, both runs — its version string is only
      emitted on first install, so run 2's CSV records it as "unknown"; v2.0.0 is from run 1.<br />
      ‡ LiteLLM Rust: as of 2026-09-07 no public build exists — the harness's own notes build it
      from a private branch on LiteLLM's machine. We'll run it when one is published.
    </p>
    </details>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <code class="bench-repro">bash bench/gateway/aigatewaybench/run.sh</code>
      <a href="https://docs.tracelane.dev/benchmarks" class="link-accent">Full method, caveats and the raw CSVs →</a>
    </div>

    
  </section>

  <CompareTable />

  {/* ===== Audit ledger — copy left, terminal frame right ===== */}
  <section id="audit" class="band">
    <div class="band-inner">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)] lg:gap-16 lg:items-center reveal">
        <div>
          <p class="eyebrow mb-4">The audit ledger</p>
          <h2 class="display-lg text-fg">Every run. On the record. <span class="link-accent">Provably.</span></h2>
          <p class="mt-5 text-fg-muted leading-relaxed" style="text-wrap:pretty">
            SHA-256 hash-chained, Ed25519-signed — verify your ledger offline with the open verifier.
          </p>
          <p class="mt-6"><a href="/security" class="link-accent">Full security posture →</a></p>

          <p class="mt-5 text-fg-muted leading-relaxed">The ledger covers gateway-admitted calls and their recorded guardrail verdicts; SDK/OTLP-only spans are captured, not chained; the trace ledger badge shows whether that trace has a ledger record.</p>
          <div class="chain" aria-hidden="true">
            <div class="chain-node"><b>event</b><span>sha-256</span></div>
            <div class="chain-link"></div>
            <div class="chain-node"><b>event</b><span>sha-256</span></div>
            <div class="chain-link"></div>
            <div class="chain-node"><b>event</b><span>sha-256</span></div>
            <div class="chain-link"></div>
            <div class="chain-node chain-node--root"><b>merkle root</b><span>ed25519</span></div>
          </div>
        </div>

        <div class="stage-well">
          <div class="frame">
            <div class="frame-bar">
              <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="frame-title">tlane — verify</span>
            </div>
            <div class="frame-body">
<pre class="term"><code><span class="c"># verify any trace offline — no trust in us required</span>
<span class="p">$</span> tlane verify ./audit.ndjson --tenant-pubkey &lt;b64&gt;
<span class="ok">✓</span> tlane verify: PASS
<span class="ok">✓</span> hash_chain_valid: true · signatures_valid: true
<span class="ok">✓</span> anchors_included: 12 (Sigstore Rekor v2) <span class="caret">&nbsp;</span></code></pre>
            </div>
          </div>
        </div>
      </div>

      <details class="mt-12 audit-details">
        <summary class="text-sm">EU AI Act, India DPDP and HIPAA — what the ledger does and does not cover</summary>
      <div class="mt-4 grid gap-4 md:grid-cols-3 text-sm reveal-group cards-hover">
        <div class="glass p-6">
          <p class="card-index">eu ai act</p>
          <p class="card-body text-sm">Article 12: the tamper-evident ledger, signing and anchoring are on every tier today; the Article 12 export ships on Enterprise and does not yet carry per-record inclusion proofs or a signed completeness attestation. Annex III enforcement provisionally deferred to Dec 2, 2027 (Digital Omnibus political agreement, May 7, 2026; pending formal adoption — <a href="https://www.whitecase.com/insight-alert/eu-agrees-digital-omnibus-deal-simplify-ai-rules" class="link-accent" rel="noopener">details</a>).</p>
        </div>
        <div class="glass p-6">
          <p class="card-index">india dpdp</p>
          <p class="card-body text-sm">Tracelane enforces no per-tenant storage region today; traces and the ledger are stored in the EU (Germany), with the cold tier in EU-jurisdiction object storage. The audit ledger has no expiry clock — it is kept for the life of the ledger.</p>
        </div>
        <div class="glass p-6">
          <p class="card-index">hipaa</p>
          <p class="card-body text-sm">No signed BAA today, so do not route PHI through the hosted gateway. Prompt and response text is not written to your traces unless we enable capture for your workspace; the response cache holds cacheable responses in memory for up to 7 days, and durably when your workspace has an embedding key. Inline redaction (Team and above) masks structured identifiers only — card numbers, SSNs, emails, E.164 phone numbers and secret-shaped strings — never names, addresses or free-text clinical detail. Provider keys are AES-256-GCM encrypted at rest, bound to your workspace and provider, under a rotatable master key.</p>
        </div>
      </div>
      </details>
    </div>
  </section>

  {/* ===== Migration — copy left, two overlapping frames right ===== */}
  <section id="migrate" class="panel">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)] lg:gap-16 lg:items-center reveal">
      <div>
        <p class="eyebrow mb-4">Migration</p>
        <h2 class="display-md text-fg">Moving off a tool that changed hands or changed its terms?</h2>
        <p class="mt-5 text-fg-muted leading-relaxed" style="text-wrap:pretty">
          One command rewrites your config. Nothing leaves your infrastructure.
        </p>
      </div>

      <div class="stage-well stage-well--scenic">
        <div class="frame-stack">
          <div class="frame">
            <div class="frame-bar">
              <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="frame-title">tlane — migrate helicone</span>
            </div>
            <div class="frame-body">
<pre class="term"><code><span class="c"># rewrites HELICONE_* env vars, base URLs and custom</span>
<span class="c"># headers across your source tree — printed as a diff,</span>
<span class="c"># dry-run by default</span>
<span class="p">$</span> tlane migrate helicone</code></pre>
            </div>
          </div>

          <div class="frame frame-over">
            <div class="frame-bar">
              <span class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="frame-title">tlane — import-litellm</span>
            </div>
            <div class="frame-body">
<pre class="term" style="color:var(--color-fg)"><code><span class="c" style="color:var(--color-fg-dim)"># reads litellm_config.yaml and prints your providers,</span>
