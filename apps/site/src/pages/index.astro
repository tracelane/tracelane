<script is:inline>
  // hero video stage — reveal native player on click
  (function () {
    var play = document.getElementById("hero-play");
    var vid = document.getElementById("hero-video");
    if (!play || !vid) return;
    play.addEventListener("click", function () {
      play.style.display = "none";
      vid.currentTime = 0;
      vid.muted = false;
      vid.controls = true;
      var p = vid.play(); if (p && p.catch) p.catch(function () {});
    });
    vid.addEventListener("ended", function () {
      vid.controls = false;
      play.style.display = "";
    });
  })();

  // hero request-flow diagram — hover/focus a node, the readout line updates
  // and the connecting pulse highlights. No libraries; CSS keyframes drive the
  // idle animation, this only swaps text + an "active" class on hover/focus.
  (function () {
    var flow = document.getElementById("hero-flow");
    var readout = document.getElementById("hero-flow-readout");
    if (!flow || !readout) return;
    var nodes = flow.querySelectorAll(".flow-node");
    var defaultText = readout.textContent;
    nodes.forEach(function (node) {
      var setActive = function () {
        flow.classList.add("is-focused");
        node.classList.add("is-active");
        readout.textContent = node.dataset.state || defaultText;
      };
      var clearActive = function () {
        flow.classList.remove("is-focused");
        node.classList.remove("is-active");
        readout.textContent = defaultText;
      };
      node.addEventListener("mouseenter", setActive);
      node.addEventListener("focus", setActive);
      node.addEventListener("mouseleave", clearActive);
      node.addEventListener("blur", clearActive);
    });
  })();

  // scroll reveal lives in Base.astro — it is layout behaviour, not homepage behaviour.

  // notify form
  (function () {
    var form = document.getElementById("notify-form");
    var status = document.getElementById("notify-status");
    if (!form || !status) return;
    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      var emailInput = document.getElementById("email");
      var submitBtn = form.querySelector("button[type='submit']");
      if (!emailInput || !submitBtn) return;
      var email = emailInput.value.trim();
      status.textContent = "Sending...";
      submitBtn.disabled = true;
      try {
        var res = await fetch("/api/notify", {
          method: "POST",
          body: JSON.stringify({ email: email }),
          headers: { "Content-Type": "application/json" },
        });
        if (res.ok) { status.textContent = "You're on the list. We'll email you when something ships."; form.reset(); }
        else { var data = await res.json().catch(function () { return {}; }); status.textContent = data.error || "Something went wrong. Try again."; }
      } catch (err) { status.textContent = "Network error. Try again."; }
      finally { submitBtn.disabled = false; }
    });
  })();
</script>
