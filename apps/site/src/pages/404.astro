---
import Base from "../layouts/Base.astro";
---

<Base title="404 · Tracelane" description="Page not found.">
  <section class="container py-32 text-center">
    <p class="eyebrow eyebrow--center w-full">404</p>
    <h1 class="mt-5 display-xl text-fg">Not found.</h1>
    <p class="mt-6 lede mx-auto text-center">This page doesn't exist or has moved.</p>
    <div class="mt-12 flex justify-center gap-4">
      <a href="/" class="btn-primary lowercase">home</a>
      <a href="/docs" class="btn-secondary lowercase">docs</a>
    </div>
  </section>
</Base>
