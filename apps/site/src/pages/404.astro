---
import Base from "../layouts/Base.astro";
---

<Base title="404 · Tracelane" description="Page not found.">
  <section class="container py-32 text-center">
    <p class="font-mono text-xs text-fg-dim lowercase tracking-wider">404</p>
    <h1 class="mt-4 text-5xl sm:text-6xl font-semibold tracking-tight text-fg">Not found.</h1>
    <p class="mt-6 text-lg text-fg-muted">This page doesn't exist or has moved.</p>
    <div class="mt-12 flex justify-center gap-4">
      <a href="/" class="btn-primary lowercase">home</a>
      <a href="/docs" class="btn-secondary lowercase">docs</a>
    </div>
  </section>
</Base>
