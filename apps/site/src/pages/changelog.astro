---
/**
 * /changelog — public progress and changelog page.
 *
 * Reinstated 2026-09-07 (founder request), reversing ADR-074 §10's scope
 * decision to drop the page. See the supersession note added to that ADR.
 *
 * SITE-04 (founder 2026-09-29): run the way a founder runs it — a signed note, then
 * month by month, each month under three plain headings: New features · Improvements ·
 * Fixes. Supersedes the 2026-09-27 six-pillar layout: its stat cards, cadence chart,
 * pillar build map and the sticky filter bar with its script were removed. The pillar
 * survives only as the small label on each entry.
 *
 * ALL ENTRY COPY LIVES IN:  apps/site/src/data/changelog-data.ts
 * The founder's note below is the one piece of prose held here; it states only what
 * the page itself shows (dating rule, the proven label, where fixes go, undated next).
 *
 * MONTH IS THE FINEST GRANULARITY THIS PAGE SHOWS — founder ruling, 2026-09-09:
 * "just show the weekly or monthly wise data. No need to share day wise data."
 * Entries keep their exact `date` in the data file (it orders and groups them); the
 * day is never rendered.
 *
 * BANNED STRINGS: the seven strings in scripts/deploy/site.sh:78-85 are
 * absent from this template. In particular, no npm scope is named here —
 * see the data file header for the reason.
 */
import Base from "../layouts/Base.astro";
import {
  ENTRIES,
  TYPE_LABEL,
  KIND_LABEL,
  NEXT,
  type EntryKind,
} from "../data/changelog-data.ts";

/** "2026-09" → "September 2026" */
function fmtMonth(ym: string): string {
  return new Intl.DateTimeFormat("en", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${ym}-01T00:00:00Z`));
}

/** Stable anchor per entry, so a single change can be linked to. */
function slug(e: { date: string; title: string }): string {
  return `e-${e.date}-${e.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`;
}

// ENTRIES is newest-first; Map keeps insertion order, so months are newest-first too.
const byMonth = new Map<string, typeof ENTRIES>();
for (const e of ENTRIES) {
  const m = e.date.slice(0, 7);
  byMonth.set(m, [...(byMonth.get(m) ?? []), e]);
}
const KINDS = Object.keys(KIND_LABEL) as EntryKind[];
const months = [...byMonth.entries()].map(([ym, entries]) => ({
  ym,
  total: entries.length,
  groups: KINDS.map((k) => ({ kind: k, entries: entries.filter((e) => e.kind === k) })).filter(
    (g) => g.entries.length > 0,
  ),
}));

// The fact strip: every number DERIVED from the rows it counts, never typed.
const provenCount = ENTRIES.filter((e) => e.state === "proven").length;
const firstMonth = fmtMonth(ENTRIES[ENTRIES.length - 1]!.date.slice(0, 7));
---

<Base
  title="Changelog — Tracelane"
  description="Everything shipped in Tracelane since May 2026, month by month — new features, improvements and fixes — with every production proof labelled."
  canonical="/changelog"
>
  <section class="panel hero-band cl-hero">
    <p class="eyebrow">changelog</p>
    <h1 class="display-lg mt-5">What shipped, month by month.</h1>
    <p class="cl-facts mt-5">
      <span><b>{ENTRIES.length}</b> changes</span>
      <span><b>{provenCount}</b> proven on production</span>
      <span>{firstMonth} to today</span>
    </p>

    <figure class="cl-note mt-8">
      <blockquote>
        <p>
          I run this page myself, and it is how I hold Tracelane to what it says. Every entry
          is something you can use today, dated to the month it became real for you, not the
          month it was merged. Where a change has been proven on production (a real request
          sent, a real row read back) it says <em>proven</em>. When something was broken, it
          goes under Fixes instead of being folded quietly into a feature. What I am working
          toward is at the bottom, without dates, because a date I cannot keep is a claim I
          cannot back.
        </p>
      </blockquote>
      <figcaption>Sanjeev, founder</figcaption>
    </figure>
  </section>

  <section class="panel cl-timeline" aria-label="Changelog">
    {months.map((m) => (
      <div class="cl-month" id={`month-${m.ym}`}>
        <h2 class="cl-month-title">
          <time datetime={m.ym}>{fmtMonth(m.ym)}</time>
          <span class="cl-month-count">{m.total} {m.total === 1 ? "change" : "changes"}</span>
        </h2>
        <div class="cl-month-body">
          {m.groups.map((g) => (
            <div class={`cl-group cl-group--${g.kind}`}>
              <h3 class="cl-group-title">
                {KIND_LABEL[g.kind]}
                <span class="cl-group-count">{g.entries.length}</span>
              </h3>
              <ul class="cl-list">
                {g.entries.map((entry) => (
                  <li class="cl-entry" id={slug(entry)}>
                    <p class="cl-title">{entry.title}</p>
                    <p class="cl-use">{entry.use}</p>
                    <p class="cl-meta">
                      <span>{TYPE_LABEL[entry.type]}</span>
                      {entry.state === "proven" && (
                        <span class="cl-proven" title="Proven on production">✓ proven</span>
                      )}
                      {entry.id && <span class="cl-id">{entry.id}</span>}
                      {entry.doc && (
                        <a href={`https://docs.tracelane.dev${entry.doc}`} class="link-accent" rel="noopener">
                          Docs →
                        </a>
                      )}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="panel cl-next" aria-labelledby="cl-next-h">
    <p class="eyebrow">what's next</p>
    <h2 class="display-md mt-4" id="cl-next-h">Where I'm taking it.</h2>
    <p class="lede mt-4">Directions, not commitments. No dates.</p>
    <div class="cl-next-grid mt-8">
      {NEXT.map((item) => (
        <div class="glass cl-next-card">
          <h3 class="card-title">{item.theme}</h3>
          <p class="card-body">{item.blurb}</p>
        </div>
      ))}
    </div>
    <div class="cl-cta-links">
      <a href="https://github.com/tracelane/tracelane/blob/main/CHANGELOG.md" class="btn-secondary" rel="noopener">
        The full release notes on GitHub
      </a>
      <a href="https://app.tracelane.dev/sign-in" class="btn-primary">Start free <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .cl-hero { padding-top: clamp(3rem, 6vw, 5rem); }
  .cl-facts { display: flex; flex-wrap: wrap; gap: 0.35rem 1.5rem; color: var(--ink-2); font-size: var(--text-sm); }
  .cl-facts b { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .cl-note { max-width: 44rem; margin: 2rem 0 0; border-left: 2px solid var(--action); padding-left: 1.25rem; }
  .cl-note p { color: var(--ink); font-size: 1.0625rem; line-height: 1.65; }
  .cl-note em { font-style: normal; font-weight: 600; color: var(--action-ink); }
  .cl-note figcaption { margin-top: 0.75rem; font: 500 0.75rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }

  .cl-timeline { padding-top: clamp(2rem, 4vw, 3rem); }
  /* Month on the left, its three groups on the right (stacks on a phone). */
  .cl-month { display: grid; gap: 1rem 3rem; padding-block: 2.5rem; border-top: 1px solid var(--line); scroll-margin-top: 6rem; }
  .cl-month:first-child { border-top: 0; padding-top: 0.5rem; }
  @media (min-width: 900px) { .cl-month { grid-template-columns: 13rem minmax(0, 1fr); } }
  .cl-month-title { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.015em; align-self: start; display: grid; gap: 0.3rem; }
  @media (min-width: 900px) { .cl-month-title { position: sticky; top: 6.5rem; } }
  .cl-month-count { font: 500 0.75rem var(--font-mono); color: var(--ink-3); letter-spacing: 0.04em; }
  .cl-month-body { display: grid; gap: 2rem; }
  .cl-group-title { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-2); padding-bottom: 0.6rem; border-bottom: 1px solid var(--line); }
  .cl-group-title::before { content: ""; width: 0.5rem; height: 0.5rem; background: var(--ink-3); }
  .cl-group--feature .cl-group-title::before { background: var(--action); }
  .cl-group--fix .cl-group-title::before { background: var(--ink); }
  .cl-group-count { font: 500 0.7rem var(--font-mono); color: var(--ink-3); }
  .cl-list { list-style: none; margin: 0; padding: 0; }
  .cl-entry { padding-block: 1rem; border-bottom: 1px solid var(--line); scroll-margin-top: 6rem; }
  .cl-entry:last-child { border-bottom: 0; }
  .cl-title { font-size: 1rem; font-weight: 600; color: var(--ink); letter-spacing: -0.01em; }
  .cl-use { margin-top: 0.3rem; color: var(--ink-2); font-size: var(--text-sm); line-height: 1.6; max-width: 46rem; }
  .cl-meta { margin-top: 0.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1rem; font: 500 0.6875rem var(--font-mono); letter-spacing: 0.04em; color: var(--ink-3); text-transform: uppercase; }
  .cl-meta a { text-transform: none; font-family: var(--font-sans); font-size: 0.8125rem; letter-spacing: 0; }
  .cl-proven { color: var(--color-verify); }
  .cl-id { text-transform: none; }

  .cl-next { border-top: 1px solid var(--line); padding-top: clamp(3rem, 6vw, 4.5rem); }
  .cl-next-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .cl-next-grid { grid-template-columns: repeat(3, 1fr); } }
  .cl-next-card { padding: clamp(1.25rem, 2.5vw, 1.75rem); }
  .cl-cta-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 2.5rem; }
</style>
