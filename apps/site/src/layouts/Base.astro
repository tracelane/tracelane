---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = "tracelane — the flight recorder for AI agents",
  description = "Open-source gateway for AI agents. Trace every run, replay the exact failure, and prove what happened with a tamper-evident ledger. Self-host or start free.",
  canonical = Astro.url.pathname,
  ogImage = "/og-default.png",
} = Astro.props;

const siteUrl = "https://tracelane.dev";
const fullCanonical = new URL(canonical, siteUrl).toString();
const fullOgImage = new URL(ogImage, siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://tracelane.dev/#org",
      name: "Tracelane",
      url: "https://tracelane.dev",
      logo: "https://tracelane.dev/og-default.png",
      sameAs: [
        "https://github.com/tracelane",
        "https://x.com/xsanjeevlabs",
        "https://www.linkedin.com/in/sanjeevlabs",
        "https://newsletter.aitechhive.com",
      ],
    },
    {
      "@type": "SoftwareApplication",
      name: "Tracelane",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Linux, macOS, Windows",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      softwareVersion: "1.0.0",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      url: "https://tracelane.dev",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f6f8" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Tracelane" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@xsanjeevlabs" />
    <meta name="twitter:creator" content="@xsanjeevlabs" />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Inter Tight is no longer used — the rebuilt system runs ONE sans, like the
        reference. Preloading a face the CSS never asks for is a wasted round trip
        on the critical path, so the preload follows the stylesheet. */}
    <link
      rel="preload"
      href="/fonts/inter-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="scroll-progress" id="scroll-progress"></div>
    <a href="#main" class="skip-link">skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      /* Scroll reveal — single elements (.reveal) and staggered grids
         (.reveal-group).

         THIS LIVES IN THE LAYOUT, and that is the whole fix. It used to sit in
         `index.astro`'s inline script, so it shipped to exactly one page. Every
         `.reveal` element starts at `opacity: 0` and is only made visible by the
         `.in` class this observer adds — which meant any OTHER page rendering a
         revealing component painted nothing at all.

         `/pricing` did exactly that from the day it was created (2026-08-16): it
         renders the same `PricingTable.astro` as the homepage anchor, all six
         tiers were present in the DOM, and all six sat at `opacity: 0`
         permanently. The page looked blank below the header.

         A reveal that never fires is not a missing animation, it is missing
         CONTENT — so the observer belongs anywhere a `.reveal` can appear, and
         the layout is the only place that is true of. */
      (function () {
        var els = document.querySelectorAll(".reveal, .reveal-group");
        if (!els.length) return;
        // No IntersectionObserver (or none matched): show everything rather than
        // leave the page blank. Failing OPEN is the only safe direction here.
        if (!("IntersectionObserver" in window)) {
          els.forEach(function (el) { el.classList.add("in"); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { reveal(e.target); }
          });
        }, { threshold: 0.14, rootMargin: "0px 0px -40px 0px" });
        els.forEach(function (el) { io.observe(el); });

        function reveal(el) { el.classList.add("in"); io.unobserve(el); }

        /* SELF-HEALING SWEEP — the observer alone can strand content.
           IntersectionObserver reports the state it sees ON A FRAME TICK. A fast
           flick, a `scrollTo`, an anchor jump or a restored scroll position can
           carry an element from below the fold to above it between two ticks, so
           it is never OBSERVED intersecting — and because everything here starts
           at `opacity: 0`, that element is then invisible for the life of the
           page. Measured on this page 2026-08-24 with a scripted 500px-step
           scroll: 29 of 47 elements stranded, including three whole sections.

           A reveal that never fires is missing CONTENT, not a missing animation
           (the /pricing blank-page incident, 2026-08-16). So the same predicate
           is also evaluated on demand: anything whose top has passed the bottom
           of the viewport is revealed regardless of what the observer saw. The
           observer still drives the normal case, which is what keeps the
           staggered entrance; this only catches what it dropped. */
        var sweeping = false;
        function sweep() {
          sweeping = false;
          var h = window.innerHeight;
          els.forEach(function (el) {
            if (el.classList.contains("in")) return;
            if (el.getBoundingClientRect().top < h) reveal(el);
          });
        }
        window.addEventListener("scroll", function () {
          if (!sweeping) { sweeping = true; requestAnimationFrame(sweep); }
        }, { passive: true });
        window.addEventListener("resize", function () {
          if (!sweeping) { sweeping = true; requestAnimationFrame(sweep); }
        }, { passive: true });
      })();

      // top scroll-progress bar
      (function () {
        var bar = document.getElementById("scroll-progress");
        if (!bar) return;
        var ticking = false;
        function update() {
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          var p = max > 0 ? h.scrollTop / max : 0;
          bar.style.transform = "scaleX(" + p + ")";
          ticking = false;
        }
        update();
        window.addEventListener(
          "scroll",
          function () {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true }
        );
        window.addEventListener("resize", update, { passive: true });
      })();

    </script>
  </body>
</html>
