---
const chisel = `<svg viewBox="0 0 100 100" width="26" height="26" aria-hidden="true" class="logo-mark">
  <path d="M 2,2 L 96,2 L 84,14 L 2,14 Z" fill="currentColor"/>
  <path d="M 2,14 L 14,14 L 14,28 L 44,28 L 44,40 L 12,40 L 2,30 Z" fill="currentColor"/>
  <path d="M 32,40 L 44,40 L 44,86 L 32,98 Z" fill="currentColor"/>
  <path d="M 96,16 L 96,28 L 84,40 L 54,40 L 54,28 L 84,28 Z" fill="currentColor"/>
  <path d="M 54,40 L 66,40 L 66,64 L 78,64 L 54,88 Z" fill="currentColor"/>
</svg>`;
---

<header class="site-header sticky top-0 z-50">
  <div class="site-bar flex h-[4.75rem] items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 text-fg" aria-label="tracelane home">
      <span set:html={chisel} />
      <span class="font-semibold text-lg tracking-tight lowercase" style="font-family:var(--font-display)">tracelane</span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-3 sm:gap-5">
      <ul class="flex items-center gap-4 sm:gap-6 text-sm text-fg-subtle">
        <li class="hidden sm:list-item"><a href="/#what" class="hover:text-fg transition-colors">What</a></li>
        <li class="hidden sm:list-item"><a href="/#audit" class="hover:text-fg transition-colors">Audit Ledger</a></li>
        <li class="hidden md:list-item"><a href="/pricing" class="hover:text-fg transition-colors">Pricing</a></li>
        <li class="hidden md:list-item"><a href="/security" class="hover:text-fg transition-colors">Security</a></li>
        <li class="hidden sm:list-item"><a href="https://docs.tracelane.dev" class="hover:text-fg transition-colors" rel="noopener">Docs</a></li>
        <li class="hidden sm:list-item"><a href="https://github.com/tracelane" class="hover:text-fg transition-colors" rel="me noopener">GitHub</a></li>
      </ul>
      <a href="https://app.tracelane.dev/sign-in" class="btn-secondary inline-flex whitespace-nowrap" style="padding:0.55rem 1.15rem;font-size:0.8125rem">Start Free</a>
    </nav>
  </div>
</header>

<script is:inline>
  // header gains a subtle shadow once the page is scrolled
  (function () {
    var header = document.querySelector(".site-header");
    if (!header) return;
    var onScroll = function () {
      if (window.scrollY > 8) header.classList.add("scrolled");
      else header.classList.remove("scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
