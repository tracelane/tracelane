---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

const links = [
  { href: "/#what", label: "Product" },
  { href: "/#audit", label: "Audit ledger" },
  { href: "/pricing", label: "Pricing" },
  { href: "/security", label: "Security" },
  { href: "https://docs.tracelane.dev", label: "Docs", external: true },
];
---

<header class="site-header sticky top-0 z-50">
  <!-- EVERY CELL IS PLACED EXPLICITLY (`col-start-*`), and that is the whole fix.
       The columns are `1fr auto 1fr` and the three children used to rely on AUTO
       PLACEMENT. Below `md` the nav is `hidden`, and a grid item with
       `display:none` is removed from the grid ENTIRELY — so there were only two
       items left and the CTA auto-placed into column 2, not column 3. Measured at
       390px: the CTA sat at x=156-234 with 156px of empty bar to its right, while
       at 768px it correctly sat 17px from the edge. A `justify-self-end` cannot
       fix that, because the element was in the wrong COLUMN, not misaligned
       inside the right one. With all three placed by hand, hiding the nav can no
       longer move anything. -->
  <!-- `minmax(0,1fr)`, not `1fr`, on the two outer tracks. A bare `1fr` is
       `minmax(auto,1fr)`, so each side track refuses to go below its content's
       min width — at 320px (iPhone SE) the logo lockup and the actions group
       together demanded 322px and the bar pushed the whole document 2px wide.
       `minmax(0,1fr)` lets a track shrink past its content; the actions group is
       `justify-self-end`, so it overflows LEFT into the empty centre track,
       which is where the hidden nav's space already is. -->
  <div class="site-bar grid h-[4rem] items-center" style="grid-template-columns:minmax(0,1fr) auto minmax(0,1fr)">
    <a href="/" class="col-start-1 flex items-center text-fg justify-self-start" aria-label="tracelane home">
      <Logo size={26} />
    </a>

    <nav aria-label="Primary" class="col-start-2 hidden md:block justify-self-center">
      <ul class="flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav-link"
              rel={l.external ? "noopener" : undefined}
            >{l.label}{l.external && <span class="ext" aria-hidden="true">↗</span>}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="col-start-3 flex items-center gap-2 justify-self-end">
      <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false" aria-label="Switch to dark theme">
        <Icon name="sun" size={17} dot={false} class="theme-toggle-icon theme-toggle-icon--sun" />
        <Icon name="moon" size={17} dot={false} class="theme-toggle-icon theme-toggle-icon--moon" />
      </button>
      <a href="https://github.com/tracelane" class="nav-link hidden sm:inline-flex" rel="me noopener">GitHub</a>
      <a href="https://app.tracelane.dev/sign-in" class="btn-primary btn-sm">Start free</a>
    </div>
  </div>
</header>

<script is:inline>
  // header gains a hairline rule once the page is scrolled
  (function () {
    var header = document.querySelector(".site-header");
    if (!header) return;
    var onScroll = function () {
      if (window.scrollY > 8) header.classList.add("scrolled");
      else header.classList.remove("scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();

  // theme toggle — persists the explicit choice; unset falls back to OS pref
  (function () {
    var KEY = "tracelane-theme";
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    function sync() {
      var dark = document.documentElement.dataset.theme === "dark";
      btn.setAttribute("aria-pressed", String(dark));
      btn.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
    }
    sync();
    btn.addEventListener("click", function () {
      var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem(KEY, next); } catch (e) {}
      sync();
    });
  })();
</script>
