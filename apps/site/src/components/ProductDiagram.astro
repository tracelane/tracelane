---
/**
 * One animated, decorative diagram per product section (2026-09-27). aria-hidden: the
 * page text carries every fact. Motion is CSS only and stops under prefers-reduced-motion.
 */
interface Props {
  kind: "gateway" | "observability" | "audit" | "evals";
}
const { kind } = Astro.props;
---

<figure class="pd" aria-hidden="true">
  {kind === "gateway" && (
    <svg viewBox="0 0 520 260" role="presentation">
      <rect x="14" y="104" width="104" height="52" class="pd-box" />
      <text x="66" y="135" class="pd-t">your app</text>
      <rect x="196" y="92" width="128" height="76" class="pd-box pd-accent" />
      <text x="260" y="126" class="pd-t pd-strong">tracelane</text>
      <text x="260" y="146" class="pd-t pd-sub">route · cap · record</text>
      {["anthropic", "openai", "google"].map((p, i) => (
        <g>
          <rect x="402" y={26 + i * 84} width="104" height="44" class="pd-box" />
          <text x="454" y={53 + i * 84} class="pd-t">{p}</text>
        </g>
      ))}
      <path d="M118 130 H196" class="pd-line" />
      <path d="M324 118 C360 118 364 48 402 48" class="pd-line" />
      <path d="M324 130 H402" class="pd-line pd-dim" />
      <path d="M324 142 C360 142 364 216 402 216" class="pd-line pd-dash" />
      <circle r="5" class="pd-dot"><animateMotion dur="2.4s" repeatCount="indefinite" path="M118 130 H196 M324 118 C360 118 364 48 402 48" /></circle>
      <text x="366" y="250" class="pd-t pd-sub">fallback, if you turn it on</text>
    </svg>
  )}
  {kind === "observability" && (
    <svg viewBox="0 0 520 260" role="presentation">
      {[
        [20, 460, "agent.run"], [44, 170, "gen_ai.chat"], [220, 120, "tool · search"],
        [346, 60, "retry"], [400, 100, "gen_ai.chat"], [60, 130, "retrieval"],
      ].map(([x, w, label], i) => (
        <g>
          <rect x={x as number} y={24 + i * 38} width={w as number} height="24"
            class={`pd-bar ${i === 3 ? "pd-bar-err" : ""}`} style={`animation-delay:${i * 0.18}s`} />
          <text x={(x as number) + 8} y={40 + i * 38} class="pd-t pd-left">{label}</text>
        </g>
      ))}
    </svg>
  )}
  {kind === "audit" && (
    <svg viewBox="0 0 520 260" role="presentation">
      {[0, 1, 2, 3].map((i) => (
        <g>
          <rect x={18 + i * 122} y="70" width="96" height="70" class="pd-box pd-block" style={`animation-delay:${i * 0.35}s`} />
          <text x={66 + i * 122} y="100" class="pd-t pd-strong">#{1041 + i}</text>
          <text x={66 + i * 122} y="120" class="pd-t pd-sub mono">h:{["9f2c", "a71e", "3c08", "e5b4"][i]}…</text>
          {i < 3 && <path d={`M${114 + i * 122} 105 H${140 + i * 122}`} class="pd-line" />}
        </g>
      ))}
      <path d="M260 140 V190" class="pd-line pd-dash" />
      <rect x="186" y="190" width="148" height="44" class="pd-box pd-accent" />
      <text x="260" y="217" class="pd-t pd-strong">anchored · Rekor</text>
      <text x="260" y="40" class="pd-t pd-sub">each record chains to the one before it</text>
    </svg>
  )}
  {kind === "evals" && (
    <svg viewBox="0 0 520 260" role="presentation">
      <line x1="30" x2="500" y1="96" y2="96" class="pd-floor" />
      <text x="508" y="88" class="pd-t pd-sub pd-right">your floor</text>
      {[0.82, 0.9, 0.78, 0.94, 0.61, 0.88, 0.92].map((v, i) => (
        <g>
          <rect x={36 + i * 58} y={230 - v * 190} width="38" height={v * 190}
            class={`pd-vbar ${v < 0.7 ? "pd-bar-err" : ""}`} style={`animation-delay:${i * 0.12}s`} />
        </g>
      ))}
      <text x="229" y="250" class="pd-t pd-sub">one case below the floor → the build fails</text>
    </svg>
  )}
</figure>

<style>
  .pd { margin: 0; }
  .pd svg { width: 100%; height: auto; display: block; }
  .pd-box { fill: var(--color-bg-elevated, transparent); stroke: var(--color-border-strong); stroke-width: 1.2; }
  .pd-accent { stroke: var(--color-accent); stroke-width: 1.6; }
  .pd-t { font: 500 13px var(--font-sans, system-ui); fill: var(--color-fg); text-anchor: middle; }
  .pd-left { text-anchor: start; font-size: 12px; fill: var(--color-bg-elevated); }
  .pd-right { text-anchor: end; }
  .pd-strong { font-weight: 650; }
  .pd-sub { font-size: 11px; fill: var(--color-fg-muted); }
  .mono { font-family: var(--font-mono); }
  .pd-line { stroke: var(--color-accent); stroke-width: 1.6; fill: none; }
  .pd-dim { opacity: 0.35; }
  .pd-dash { stroke-dasharray: 5 5; opacity: 0.7; }
  .pd-dot { fill: var(--color-accent); }
  .pd-floor { stroke: var(--color-fg-muted); stroke-dasharray: 6 5; }
  .pd-bar { fill: var(--color-fg); opacity: 0.88; transform-box: fill-box; transform-origin: left; animation: pd-grow 1.1s cubic-bezier(.2,.8,.2,1) both; }
  .pd-vbar { fill: var(--color-fg); opacity: 0.88; transform-box: fill-box; transform-origin: bottom; animation: pd-rise 1s cubic-bezier(.2,.8,.2,1) both; }
  @keyframes pd-rise { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .pd-bar-err { fill: var(--color-accent); opacity: 1; }
  .pd-block { animation: pd-fade 0.9s ease both; }
  @keyframes pd-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes pd-fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .pd-bar, .pd-vbar, .pd-block { animation: none; }
    .pd-dot { display: none; }
  }
</style>
