{
	"name": "tracelane",
	"version": "0.1.0",
	"private": true,
	"description": "The flight recorder for AI agents",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks || true",
		"dev": "pnpm --filter @tracelanedev/web dev",
		"dev:mcp": "pnpm --filter @tracelanedev/mcp dev",
		"build": "pnpm --filter @tracelanedev/web build",
		"lint": "pnpm --recursive run lint",
		"typecheck": "pnpm --recursive run typecheck",
		"test": "pnpm --recursive run test",
		"eval:run": "pnpm --filter @tracelanedev/evals run eval:run",
		"bench:gateway": "cargo bench -p gateway",
		"bench:gateway:overhead": "k6 run bench/gateway/overhead-measurement.js",
		"bench:gateway:rps": "k6 run bench/gateway/sustained-5k-rps.js",
		"bench:ingest": "INGEST_BUILD_SERVER=1 cargo bench -p ingest",
		"bench:budgets": "node scripts/ci/check-bench-budgets.mjs",
		"bench:all": "pnpm bench:gateway && pnpm bench:ingest && pnpm bench:budgets"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@9.15.0",
	"dependencies": {
		"@workos-inc/authkit-nextjs": "^4.0.1"
	},
	"pnpm": {
		"overrides": {
			"fast-uri": ">=4.1.5",
			"fast-xml-builder": ">=1.1.7",
			"shell-quote": ">=1.11.0",
			"@grpc/grpc-js": ">=1.14.5 <2",
			"protobufjs": ">=7.6.5 <8",
			"hono": ">=4.13.8 <5",
			"devalue": ">=5.9.4",
			"sharp": ">=0.35.4",
			"brace-expansion@2": ">=2.1.7 <3",
			"brace-expansion@>=3": ">=5.0.12",
			"postcss": ">=8.5.18",
			"valibot": ">=1.4.2",
			"qs": ">=6.16.0",
			"ip-address": ">=10.5.1",
			"@opentelemetry/core": ">=2.8.0 <3",
			"body-parser": ">=2.3.0",
			"undici@7": ">=7.29.0 <8",
			"undici@>=8": ">=8.10.2",
			"nanoid@3": ">=3.3.17 <4",
			"@hono/node-server": ">=1.19.15 <2",
			"smol-toml": ">=1.7.1",
			"js-yaml": ">=4.3.2 <5",
			"svgo": ">=4.1.0",
			"vitest>vite": ">=7.3.6 <8",
			"vite-node>vite": ">=7.3.6 <8",
			"esbuild@<=0.24.2": ">=0.25.0 <0.26",
			"esbuild@>=0.27.3 <0.28.1": ">=0.28.1 <0.29",
			"proxy-addr": ">=2.0.8 <3",
			"tinypool": ">=2.1.2 <3"
		},
		"auditConfig": {
			"ignoreGhsas": [
				"GHSA-ch52-4w7c-c8xp"
			]
		}
	}
}
