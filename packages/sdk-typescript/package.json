		},
		"./mcp": {
			"import": { "types": "./dist/instrumentations/mcp.d.mts", "default": "./dist/instrumentations/mcp.mjs" },
			"require": { "types": "./dist/instrumentations/mcp.d.ts", "default": "./dist/instrumentations/mcp.js" }
		},
		"./claude_code": {
			"import": { "types": "./dist/instrumentations/claude_code.d.mts", "default": "./dist/instrumentations/claude_code.mjs" },
			"require": { "types": "./dist/instrumentations/claude_code.d.ts", "default": "./dist/instrumentations/claude_code.js" }
		},
		"./cursor": {
			"import": { "types": "./dist/instrumentations/cursor.d.mts", "default": "./dist/instrumentations/cursor.mjs" },
