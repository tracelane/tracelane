{
	"name": "@tracelanedev/sdk",
	"version": "0.2.3",
	"description": "Tracelane TypeScript SDK — auto-instrument AI agent frameworks",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tracelane/tracelane.git",
		"directory": "packages/sdk-typescript"
	},
	"homepage": "https://tracelane.dev",
	"bugs": "https://github.com/tracelane/tracelane/issues",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
			"require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
		},
		"./anthropic": {
			"import": { "types": "./dist/instrumentations/anthropic.d.mts", "default": "./dist/instrumentations/anthropic.mjs" },
			"require": { "types": "./dist/instrumentations/anthropic.d.ts", "default": "./dist/instrumentations/anthropic.js" }
		},
		"./openai": {
			"import": { "types": "./dist/instrumentations/openai.d.mts", "default": "./dist/instrumentations/openai.mjs" },
			"require": { "types": "./dist/instrumentations/openai.d.ts", "default": "./dist/instrumentations/openai.js" }
		},
		"./litellm": {
			"import": { "types": "./dist/instrumentations/litellm.d.mts", "default": "./dist/instrumentations/litellm.mjs" },
			"require": { "types": "./dist/instrumentations/litellm.d.ts", "default": "./dist/instrumentations/litellm.js" }
		},
		"./langchain": {
			"import": { "types": "./dist/instrumentations/langchain.d.mts", "default": "./dist/instrumentations/langchain.mjs" },
			"require": { "types": "./dist/instrumentations/langchain.d.ts", "default": "./dist/instrumentations/langchain.js" }
		},
		"./openrouter": {
			"import": { "types": "./dist/instrumentations/openrouter.d.mts", "default": "./dist/instrumentations/openrouter.mjs" },
			"require": { "types": "./dist/instrumentations/openrouter.d.ts", "default": "./dist/instrumentations/openrouter.js" }
		},
		"./langgraph": {
			"import": { "types": "./dist/instrumentations/langgraph.d.mts", "default": "./dist/instrumentations/langgraph.mjs" },
			"require": { "types": "./dist/instrumentations/langgraph.d.ts", "default": "./dist/instrumentations/langgraph.js" }
		},
		"./openai_agents": {
			"import": { "types": "./dist/instrumentations/openai_agents.d.mts", "default": "./dist/instrumentations/openai_agents.mjs" },
			"require": { "types": "./dist/instrumentations/openai_agents.d.ts", "default": "./dist/instrumentations/openai_agents.js" }
		},
		"./vercel_ai": {
			"import": { "types": "./dist/instrumentations/vercel_ai.d.mts", "default": "./dist/instrumentations/vercel_ai.mjs" },
