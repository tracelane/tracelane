		},
		"./composio": {
			"import": { "types": "./dist/instrumentations/composio.d.mts", "default": "./dist/instrumentations/composio.mjs" },
			"require": { "types": "./dist/instrumentations/composio.d.ts", "default": "./dist/instrumentations/composio.js" }
		},
		"./browserbase": {
			"import": { "types": "./dist/instrumentations/browserbase.d.mts", "default": "./dist/instrumentations/browserbase.mjs" },
			"require": { "types": "./dist/instrumentations/browserbase.d.ts", "default": "./dist/instrumentations/browserbase.js" }
		},
		"./e2b": {
			"import": { "types": "./dist/instrumentations/e2b.d.mts", "default": "./dist/instrumentations/e2b.mjs" },
			"require": { "types": "./dist/instrumentations/e2b.d.ts", "default": "./dist/instrumentations/e2b.js" }
		},
		"./mem0": {
			"import": { "types": "./dist/instrumentations/mem0.d.mts", "default": "./dist/instrumentations/mem0.mjs" },
			"require": { "types": "./dist/instrumentations/mem0.d.ts", "default": "./dist/instrumentations/mem0.js" }
		},
		"./letta": {
			"import": { "types": "./dist/instrumentations/letta.d.mts", "default": "./dist/instrumentations/letta.mjs" },
			"require": { "types": "./dist/instrumentations/letta.d.ts", "default": "./dist/instrumentations/letta.js" }
		},
		"./firecrawl": {
			"import": { "types": "./dist/instrumentations/firecrawl.d.mts", "default": "./dist/instrumentations/firecrawl.mjs" },
			"require": { "types": "./dist/instrumentations/firecrawl.d.ts", "default": "./dist/instrumentations/firecrawl.js" }
		}
	},
	"scripts": {
		"build": "tsup",
		"prepublishOnly": "pnpm run build",
		"dev": "tsup --watch",
		"lint": "biome check src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"peerDependencies": {
		"@anthropic-ai/sdk": ">=0.26.0",
		"openai": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"@anthropic-ai/sdk": { "optional": true },
		"openai": { "optional": true }
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/sdk-node": "^0.221.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/semantic-conventions": "^1.27.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@opentelemetry/sdk-trace-base": "^2.0.0",
		"@types/node": "^22.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.5.0",
		"vitest": "^2.0.0"
	},
	"files": ["dist"],
	"engines": { "node": "^18.19.0 || >=20.6.0" },
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"keywords": [
		"tracelane",
		"opentelemetry",
		"ai-observability",
		"llm-tracing",
		"instrumentation"
	]
}
