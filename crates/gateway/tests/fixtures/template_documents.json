{
  "payments_cents": {
    "contract": {
      "tool_ref": "22222222-2222-4222-8222-222222222222",
      "server_id": "11111111-1111-4111-8111-111111111111",
      "tool_name": "release_payment",
      "version": 1,
      "protected": true,
      "fields": {
        "amount": {
          "path": "/amount",
          "kind": "minor_units",
          "required": true,
          "evidence": "clear"
        },
        "beneficiary": {
          "path": "/beneficiary",
          "kind": "string",
          "required": true,
          "evidence": "tokenize"
        },
        "currency": {
          "path": "/currency",
          "kind": "currency",
          "required": true,
          "evidence": "clear"
        }
      }
    },
    "policy": {
      "approval_ttl_secs": 3600,
      "policy_id": "33333333-3333-4333-8333-333333333333",
      "version": 1,
      "rules": [
        {
          "id": "allow-small-approved",
          "when": [
            {
              "field": "amount",
              "op": "lte",
              "value": 500000
            },
            {
              "field": "beneficiary",
              "op": "in_list",
              "value": [
                "acme-ltd",
                "globex"
              ]
            }
          ],
          "decision": "allow"
        },
        {
          "id": "hold-large-approved",
          "when": [
            {
              "field": "amount",
              "op": "gt",
              "value": 500000
            },
            {
              "field": "beneficiary",
              "op": "in_list",
              "value": [
                "acme-ltd",
                "globex"
              ]
            }
          ],
          "decision": "require_approval"
        },
        {
          "id": "deny-unknown-beneficiary",
          "when": [
            {
              "field": "beneficiary",
              "op": "not_in_list",
              "value": [
                "acme-ltd",
                "globex"
              ]
            }
          ],
          "decision": "deny"
        }
      ]
    }
  },
