      ],
      "requestBody": {
        "type": "object",
        "properties": {
          "grace_hours": {
            "type": "integer"
          }
        }
      },
      "responses": {
        "200": {
          "description": "The successor (rawKey once).",
          "schema": {
            "type": "object"
          }
        },
