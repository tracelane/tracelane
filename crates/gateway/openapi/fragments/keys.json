{
  "module": "crates/gateway/src/key_routes.rs",
  "operations": {
    "POST /v1/keys": {
      "summary": "Mint an API key. rawKey is returned once.",
      "tags": [
        "keys"
      ],
      "requestBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires_at": {
            "type": "string"
          },
          "budget_usd_monthly": {
            "type": "number"
          },
          "rate_limit_rpm": {
            "type": "integer"
          },
          "budget_reset": {
            "enum": [
              "daily",
              "weekly",
              "monthly"
            ]
          },
          "velocity_breaker": {
            "type": "boolean"
          },
          "project_id": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/PolicyDocument"
          }
        },
        "required": [
          "name"
        ]
      },
      "responses": {
        "201": {
          "description": "The key, with rawKey.",
          "schema": {
            "type": "object"
          }
        },
        "400": {
          "description": "Refused: invalid_field (names `field`) or invalid_body.",
          "schema": {
            "$ref": "#/components/schemas/ControlError"
          }
        }
      },
      "x-error-codes": [
        "invalid_field",
        "invalid_body",
        "role_forbidden",
        "unavailable"
      ]
    },
    "GET /v1/keys/{id}": {
      "summary": "One key's metadata and window spend (never key material).",
      "tags": [
        "keys"
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "The key (camelCase) plus spend.",
          "schema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "keyPrefix": {
                "type": "string"
              },
              "lastUsedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
