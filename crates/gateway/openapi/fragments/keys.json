                ]
              },
              "scope": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "expiresAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "budgetUsdMonthly": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rateLimitRpm": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "budgetReset": {
                "enum": [
                  "daily",
                  "weekly",
                  "monthly"
                ]
              },
              "velocityBreaker": {
                "type": "boolean"
              },
              "revokedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "projectId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "environment": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "policy": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/PolicyDocument"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "404": {
          "description": "not_found",
          "schema": {
            "$ref": "#/components/schemas/ControlError"
          }
        }
      },
      "x-error-codes": [
        "not_found",
        "insufficient_scope",
        "unavailable"
      ]
    },
