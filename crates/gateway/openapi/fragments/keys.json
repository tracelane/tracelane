    "POST /v1/keys/{id}/rotate": {
      "summary": "Rotate a key: mint a successor, keep the old one for grace_hours.",
      "tags": [
        "keys"
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
